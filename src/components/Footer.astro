---
import { Image } from 'astro:assets';
import logo from '../assets/logo-light.png';
import '../styles/components/footer.css';

const columns = [
	{
		heading: 'Features',
		links: [
			{ href: '/features#chatbot', label: 'AI Chatbot' },
			{ href: '/features#crm', label: 'CRM' },
			{ href: '/features#review-management', label: 'Review Management' },
			{ href: '/features#mobile-app', label: 'Mobile App' },
			{ href: '/features#smart-booking', label: 'Booking System' },
		],
	},
	{
		heading: 'Industries',
		links: ['Real Estate', 'Solar', 'Dental', 'Trades', 'Coaching'].map((label) => ({
			href: '/#built-for-you',
			label,
		})),
	},
	{
		heading: 'Company',
		links: [
			{ href: '/about-us', label: 'About Us' },
			{ href: '/web-services', label: 'Web Services' },
			{ href: '/features', label: 'Features' },
			{ href: '/plans', label: 'Plans' },
			{ href: '/blog', label: 'Blog' },
			{ href: '/contact', label: 'Contact' },
		],
	},
];

const socials = [
	{
		href: 'https://www.facebook.com/Sharktechvcpility',
		label: 'Facebook',
		icon: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
	},
	{
		href: 'https://www.instagram.com/sharktechvcpility/',
		label: 'Instagram',
		icon: '<path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.42.56.21.96.47 1.38.89.42.42.68.82.9 1.38.16.43.36 1.07.41 2.24.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.81-.41 2.24-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.89-.43.17-1.06.37-2.23.42-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.42-.56-.21-.96-.47-1.38-.89-.42-.42-.68-.82-.9-1.38-.16-.43-.36-1.07-.41-2.24-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.81.41-2.24.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.89.43-.17 1.06-.37 2.23-.42 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.31-1.46.72-2.13 1.38C1.35 2.68.94 3.35.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13.67.67 1.34 1.07 2.13 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.31 1.46-.72 2.13-1.38.67-.67 1.07-1.34 1.38-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.31-.79-.72-1.46-1.38-2.13-.67-.67-1.34-1.07-2.13-1.38-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0m0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84M12 16a4 4 0 1 1 4-4 4 4 0 0 1-4 4m6.41-10.85a1.44 1.44 0 1 0 1.44 1.44 1.44 1.44 0 0 0-1.44-1.44"/>',
	},
];

const contacts = [
	{
		label: 'Email',
		value: 'growth@vcpility.com.au',
		href: 'mailto:growth@vcpility.com.au',
		icon: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>',
	},
	{
		label: 'Phone',
		value: '+61 468 487 373',
		href: 'tel:+61468487373',
		icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
	},
	{
		label: 'Support',
		value: '24/7 Available',
		icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
	},
];

const locations = ['Sydney', 'Melbourne', 'Brisbane'];
const pin = '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>';
const year = new Date().getFullYear();
---

<footer class="footer" data-reveal>
	<div class="footer__main">
		<div class="footer__grid">
			<div class="footer__brand footer__col" style="--i: 0">
				<a href="/" class="footer__logo">
					<Image src={logo} alt="VCPility" height={80} />
				</a>
				<p class="footer__desc">
					AI-powered automation for Australian businesses. We help you stop drowning in admin and
					start growing your business.
				</p>
				<ul class="footer__social">
					{
						socials.map(({ href, label, icon }) => (
							<li>
								<a href={href} class="footer__social-link" aria-label={label} target="_blank" rel="noopener">
									<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
								</a>
							</li>
						))
					}
				</ul>
			</div>

			{
				columns.map(({ heading, links }, i) => (
					<nav class="footer__column footer__col" aria-label={heading} style={`--i: ${i + 1}`}>
						<h2 class="footer__heading">{heading}</h2>
						<ul class="footer__links">
							{links.map(({ href, label }) => (
								<li>
									<a href={href} class="footer__link">
										{label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}

			<div class="footer__contact footer__col" style={`--i: ${columns.length + 1}`}>
				<h2 class="footer__heading">Get In Touch</h2>
				<ul class="footer__contact-list">
					{
						contacts.map(({ label, value, href, icon }) => (
							<li class="footer__contact-item">
								<span class="footer__contact-icon">
									<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
								</span>
								<span class="footer__contact-text">
									<span class="footer__contact-label">{label}</span>
									{href ? (
										<a href={href} class="footer__contact-value">
											{value}
										</a>
									) : (
										<span class="footer__contact-value">{value}</span>
									)}
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="footer__bottom">
			<p class="footer__copyright">
				<span class="bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
				<span>© {year} <span class="footer__name">Sharktech VCPility</span>. All rights reserved.</span>
			</p>
			<ul class="footer__locations" aria-label="Locations">
				{
					locations.map((city) => (
						<li class="footer__location">
							<svg viewBox="0 0 24 24" aria-hidden="true" set:html={pin} />
							{city}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</footer>
