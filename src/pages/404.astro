---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/404.css';

const arrow = '<path d="M5 12h14M12 5l7 7-7 7"/>';

const quickLinks = [
	{ href: '/about-us', label: 'About Us' },
	{ href: '/features', label: 'Features' },
	{ href: '/plans', label: 'Plans' },
	{ href: '/contact', label: 'Contact Us' },
];
---

<Layout title="404 - Page Not Found | VCPility" noindex>
	<!-- ============================================
	     Not found
	     ============================================ -->
	<section class="notfound">
		<div class="container notfound__inner">
			<p class="label reveal">
				<span class="bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
				Error 404
			</p>

			<!-- Big 404: the 0 is a sleepy ring with a red dot orbiting it -->
			<p class="notfound__code reveal" style="--d: 0.05s" aria-label="404" data-pause-offscreen>
				<span aria-hidden="true">4</span>
				<span class="notfound__zero" aria-hidden="true">
					<svg class="notfound__ring" viewBox="0 0 100 100">
						<circle cx="50" cy="50" r="44" />
						<path class="notfound__eye" d="M33 52q5 5 10 0" />
						<path class="notfound__eye" d="M57 52q5 5 10 0" />
					</svg>
					<span class="notfound__orbit"><span></span></span>
					<span class="notfound__z">
						{['z', 'z', 'z'].map((z, k) => <span style={`--k: ${k}`}>{z}</span>)}
					</span>
				</span>
				<span aria-hidden="true">4</span>
			</p>

			<h1 class="notfound__title reveal-lines" style="--d: 0.15s">
				<span class="line"><span class="line__inner">This Page Took</span></span>
				<span class="line" style="--i: 1"><span class="line__inner muted">a Day Off</span></span>
			</h1>

			<p class="lead reveal" style="--d: 0.25s">
				The page you're looking for doesn't exist or has moved. Let's get you back to growing your
				business.
			</p>

			<div class="notfound__buttons reveal" style="--d: 0.3s">
				<a href="/" class="btn btn--dark notfound__home" data-magnetic>
					Back to Home
					<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
				</a>
				<a href="/contact" class="btn btn--link notfound__support">
					<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
					Contact Support
				</a>
			</div>

			<nav class="notfound__links reveal" style="--d: 0.35s" aria-label="Popular pages">
				<p class="notfound__links-label">Or jump to</p>
				<ul class="notfound__links-list">
					{
						quickLinks.map(({ href, label }) => (
							<li>
								<a href={href}>{label}</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</section>
</Layout>
