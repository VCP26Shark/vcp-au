---

<Layout
	title="VCPility | Automate Your Business. Focus on Growth."
	description="Australia's leading AI automation platform. Consolidate your CRM, chatbots, reviews & marketing into one powerful system. Get more done with less effort."
	keywords="AI, automation, business growth platform, CRM"
>
	<!-- ============================================
	     Hero
	     ============================================ -->
	<section class="hero">
		<div class="hero__container">
			<div class="hero__content">
				<p class="eyebrow hero__eyebrow reveal">AI-Powered Automation</p>

				<h1
					class="hero__title reveal-lines"
					style="--d: 0.1s"
					aria-label="Stop drowning in admin. Start growing your business."
				>
					{
						heroTitle.map((text, i) => (
							<span class="line" style={`--i: ${i}`} aria-hidden="true">
								<span class="line__inner">{text}</span>
							</span>
						))
					}
				</h1>

				<p class="hero__subtitle reveal" style="--d: 0.45s">
					You didn't start your business to chase leads or spend weekends on paperwork. Let AI handle the busy work
					while you focus on what you do best.
				</p>

				<div class="hero__buttons reveal" style="--d: 0.55s">
					<a href="#three-steps" class="btn btn--accent btn--shine">
						See How It Works
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
					</a>
					<a href="/contact" class="btn btn--link">
						Book Free Strategy Call
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
					</a>
				</div>

				<dl class="hero__stats reveal" style="--d: 0.65s">
					{
						heroStats.map(({ value, suffix, decimals = 0, label }) => (
							<div class="hero__stat">
								<dt>{label}</dt>
								<dd data-count={value} data-decimals={decimals} data-suffix={suffix} data-count-delay="700">
									{value.toFixed(decimals)}
									{suffix}
								</dd>
							</div>
						))
					}
				</dl>
			</div>

			<!-- Product carousel over a live mesh-gradient shader -->
			<div class="hero__visual reveal" style="--d: 0.2s" data-pause-offscreen>
				<canvas class="shader" aria-hidden="true" data-shader></canvas>

				<div
					class="hero__frame"
					role="region"
					aria-roledescription="carousel"
					aria-label="VCPility features"
					data-hero-carousel
				>
					<div class="hero__track" data-hero-track>
						{
							heroTrack.map(({ image, title, subtitle, icon }, i) => {
								const isClone = i === heroSlides.length;
								return (
									<div
										class="hero__slide"
										role="group"
										aria-roledescription="slide"
										aria-label={`${i + 1} of ${heroSlides.length}`}
										aria-hidden={i === 0 ? undefined : 'true'}
									>
										<div class="hero__slide-image">
											<Image
												src={image}
												alt={isClone ? '' : title}
												width={960}
												widths={[480, 960]}
												sizes="(max-width: 1024px) 80vw, 520px"
												loading="eager"
												fetchpriority={i === 0 ? 'high' : 'low'}
											/>
										</div>
										<div class="hero__caption">
											<span class="hero__caption-icon">
												<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
											</span>
											<span>
												<span class="hero__caption-title">{title}</span>
												<span class="hero__caption-subtitle">{subtitle}</span>
											</span>
										</div>
									</div>
								);
							})
						}
					</div>
					<span class="hero__progress" data-hero-progress></span>
				</div>
			</div>
		</div>
	</section>

	<!-- ----- Capability marquee (rendered twice for a seamless -50% loop) ----- -->
	<div class="marquee" aria-hidden="true" data-pause-offscreen>
		<div class="marquee__track">
			{[...heroSlides, ...heroSlides].map(({ title, icon }) => (
				<span class="marquee__item">
					<svg viewBox="0 0 24 24" set:html={icon} />
					{title}
				</span>
			))}
		</div>
	</div>

	<script>
		/* Hero: carousel steps through the slides, with a progress rule timing each one */
		const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
		const track = carousel?.querySelector<HTMLElement>('[data-hero-track]');
		const bar = carousel?.querySelector<HTMLElement>('[data-hero-progress]');

		if (carousel && track && bar) {
			const INTERVAL = 4000;
			const slides = [...track.children] as HTMLElement[];
			const last = slides.length - 1; // index of the clone of the first slide
			let index = 0;
			let inView = true;

			const moveTo = (next: number) => {
				index = next;
				track.style.transform = `translateX(${-index * 100}%)`;
				slides.forEach((slide, i) => slide.setAttribute('aria-hidden', String(i !== index)));
			};

			const progress = bar.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], {
				duration: INTERVAL,
				easing: 'linear',
			});

			const sync = () => {
				if (!inView || document.hidden) progress.pause();
				else progress.play();
			};

			progress.onfinish = () => {
				// Sitting on the clone looks identical to slide one, so jump back without animating
				if (index === last) {
					track.style.transition = 'none';
					moveTo(0);
					void track.offsetWidth;
					track.style.transition = '';
				}
				moveTo(index + 1);
				progress.currentTime = 0;
				sync();
			};

			document.addEventListener('visibilitychange', sync);
			new IntersectionObserver(([entry]) => {
				inView = entry.isIntersecting;
				sync();
			}).observe(carousel);
		}
	</script>

	<!-- ============================================
	     Pain points
	     ============================================ -->
	<section class="sec pain">
		<div class="container">
			<header class="sec-head">
				<div>
					<p class="eyebrow reveal">Sound Familiar?</p>
					<h2 class="section-title section-title--sm reveal-lines" style="--d: 0.1s">
						{
							painTitle.map((text, i) => (
								<span class="line" style={`--i: ${i}`}>
									<span class="line__inner">{text}</span>
								</span>
							))
						}
					</h2>
				</div>
				<p class="sec-head__lead reveal" style="--d: 0.3s">
					Every day, brilliant business owners like you lose hours to tasks that never seem to end. It's exhausting,
					frustrating, and holds you back from real growth.
				</p>
			</header>

			<ul class="pain__grid">
				{
					painPoints.map(({ title, desc, icon }, i) => (
						<li class="pain__item reveal" style={`--d: ${(i % 3) * 0.08}s`}>
							<span class="pain__icon">
								<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
							</span>
							<h3>{title}</h3>
							<p>{desc}</p>
						</li>
					))
				}
			</ul>

			<div class="pain__cta reveal">
				<a href="/contact" class="btn btn--link">
					See How We Fix This
					<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
				</a>
			</div>
		</div>
	</section>

	<!-- ============================================
	     Daily struggle (Animated List)
	     ============================================ -->
	<section class="sec struggle">
		<div class="container struggle__grid">
			<div>
				<p class="eyebrow reveal">The Daily Struggle</p>
				<h2 class="section-title section-title--sm reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">You're Drowning</span></span>
					<span class="line" style="--i: 1"><span class="line__inner">in Busywork</span></span>
				</h2>
				<p class="sec-head__lead struggle__lead reveal" style="--d: 0.25s">
					While you're juggling admin tasks, your competitors are closing deals. Every hour spent on manual work is
					revenue slipping through your fingers.
				</p>

				<ul class="struggle__list">
					{
						struggles.map(({ title, desc, value, prefix = '', suffix = '', decimals = 0 }, i) => (
							<li class="struggle__item reveal" style={`--d: ${0.1 + i * 0.06}s`}>
								<span>
									<strong>{title}</strong>
									<span>{desc}</span>
								</span>
								<span
									class="struggle__stat"
									data-count={value}
									data-decimals={decimals}
									data-prefix={prefix}
									data-suffix={suffix}
								>
									{prefix}
									{value.toFixed(decimals)}
									{suffix}
								</span>
							</li>
						))
					}
				</ul>

				<div class="struggle__cta reveal">
					<a href="/features" class="btn btn--link">
						View All Features
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
					</a>
				</div>
			</div>

			<div class="alist reveal" style="--d: 0.2s" aria-hidden="true" data-pause-offscreen>
				<div class="alist__bar">
					<span class="alist__live"></span>
					Your day without automation
					<span class="alist__time">Today</span>
				</div>
				<ul class="alist__list" data-alist>
					{
						notifications.map(({ count, title, meta, icon }) => (
							<li class="alist__item">
