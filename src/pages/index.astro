<script>
	// Shaders, the flicker grid, tickers, icon drawing, velocity rows, text reveal, the tracing
	// beam, spotlight cards, magnetic buttons and scramble titles all run from scripts/effects.ts
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;

	/* ----- Hero carousel: steps through the slides, a progress rule timing each one ----- */
	const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
	const track = carousel?.querySelector<HTMLElement>('[data-hero-track]');
	const bar = carousel?.querySelector<HTMLElement>('[data-hero-progress]');

	if (carousel && track && bar) {
		const INTERVAL = 4500;
		const slides = [...track.children] as HTMLElement[];
		const last = slides.length - 1; // index of the clone of the first slide
		let index = 0;
		let inView = true;

		// Slides after the first are lazy; start loading the one after the current slide early
		const warm = (i: number) => {
			const img = slides[i % slides.length]?.querySelector('img');
			if (img) img.loading = 'eager';
		};
		warm(1);

		const moveTo = (next: number) => {
			index = next;
			warm(index + 1);
			track.style.transform = `translateX(${-index * 100}%)`;
			slides.forEach((slide, i) => slide.setAttribute('aria-hidden', String(i !== index)));
		};

		const progress = bar.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], {
			duration: INTERVAL,
			easing: 'linear',
		});

		const sync = () => {
			if (!inView || document.hidden) progress.pause();
			else progress.play();
		};

		progress.onfinish = () => {
			// Sitting on the clone looks identical to slide one, so jump back without animating
			if (index === last) {
				track.style.transition = 'none';
				moveTo(0);
				void track.offsetWidth;
				track.style.transition = '';
			}
			moveTo(index + 1);
			progress.currentTime = 0;
			sync();
		};

		document.addEventListener('visibilitychange', sync);
		new IntersectionObserver(([entry]) => {
			inView = entry.isIntersecting;
			sync();
		}).observe(carousel);
	}

	/* ----- Hero: a spotlight follows the pointer across the panel, and the stage tilts towards it ----- */
	const heroPanel = document.querySelector<HTMLElement>('[data-hero-panel]');
	const stage = heroPanel?.querySelector<HTMLElement>('[data-tilt]');

	if (heroPanel && stage && !reduceMotion && finePointer) {
		heroPanel.addEventListener('pointermove', (e) => {
			const panelBox = heroPanel.getBoundingClientRect();
			heroPanel.style.setProperty('--sx', `${e.clientX - panelBox.left}px`);
			heroPanel.style.setProperty('--sy', `${e.clientY - panelBox.top}px`);

			const box = stage.getBoundingClientRect();
			const x = (e.clientX - box.left) / box.width - 0.5;
			const y = (e.clientY - box.top) / box.height - 0.5;
			stage.style.setProperty('--ry', `${(x * 10).toFixed(2)}deg`);
			stage.style.setProperty('--rx', `${(y * -8).toFixed(2)}deg`);
		});
		heroPanel.addEventListener('pointerleave', () => {
			stage.style.setProperty('--rx', '0deg');
			stage.style.setProperty('--ry', '0deg');
		});
	}

	/* ----- Animated List (after Magic UI): the full list shows straight away, then the bottom
	   notification drops back in at the top, looping, while the list is on screen. ----- */
	const alist = document.querySelector<HTMLElement>('[data-alist]');

	if (alist && !reduceMotion) {
		let timer = 0;

		const rotate = () => {
			const last = alist.lastElementChild;
			if (!last) return;
			const item = last.cloneNode(true) as HTMLElement;
			last.remove();
			item.classList.add('is-entering');
			alist.prepend(item);
			requestAnimationFrame(() => requestAnimationFrame(() => item.classList.remove('is-entering')));
		};

		new IntersectionObserver(([entry]) => {
			clearInterval(timer);
			if (entry.isIntersecting) timer = window.setInterval(rotate, 2000);
		}).observe(alist);
	}

	/* ----- Industries: on hover-capable screens the row's photo trails the cursor ----- */
	const index = document.querySelector<HTMLElement>('[data-index]');
	const preview = index?.querySelector<HTMLElement>('[data-index-preview]');

	if (index && preview && finePointer) {
		const figures = [...preview.querySelectorAll<HTMLElement>('[data-index-media]')];
		const target = { x: 0, y: 0 };
		const pos = { x: 0, y: 0 };
		let frame = 0;

		const follow = () => {
			const ease = reduceMotion ? 1 : 0.14;
			pos.x += (target.x - pos.x) * ease;
			pos.y += (target.y - pos.y) * ease;
			preview.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0) rotate(${(target.x - pos.x) * 0.04}deg)`;
			if (Math.abs(target.x - pos.x) + Math.abs(target.y - pos.y) > 0.5) frame = requestAnimationFrame(follow);
			else frame = 0;
		};

		index.addEventListener('pointermove', (e) => {
			const box = index.getBoundingClientRect();
			target.x = e.clientX - box.left;
			target.y = e.clientY - box.top;
			if (!preview.classList.contains('is-shown')) {
				pos.x = target.x;
				pos.y = target.y;
			}
			if (!frame) frame = requestAnimationFrame(follow);
		});

		index.querySelectorAll<HTMLElement>('[data-index-item]').forEach((row) => {
			row.addEventListener('pointerenter', () => {
				const i = Number(row.dataset.indexItem);
				figures.forEach((fig, n) => fig.classList.toggle('is-active', n === i));
				preview.classList.add('is-shown');
			});
		});

		index.addEventListener('pointerleave', () => preview.classList.remove('is-shown'));
	}
</script>
