<script>
	import { initShaders } from '../scripts/shader';

	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	initShaders();

	/* ----- Animated List (after Magic UI) -----
	   Notifications drop in at the top one by one and the oldest falls off the
	   bottom, looping. Without JS (or with reduced motion) the full list shows. */
	const alist = document.querySelector<HTMLElement>('[data-alist]');

	if (alist && !reduceMotion) {
		const templates = [...alist.children] as HTMLElement[];
		const VISIBLE = 5;
		let next = 0;
		let timer = 0;

		alist.replaceChildren();
		alist.classList.add('is-animated');

		const push = () => {
			const item = templates[next % templates.length].cloneNode(true) as HTMLElement;
			next++;
			item.classList.add('is-entering');
			alist.prepend(item);
			requestAnimationFrame(() => requestAnimationFrame(() => item.classList.remove('is-entering')));
			while (alist.children.length > VISIBLE) alist.lastElementChild?.remove();
		};

		new IntersectionObserver(([entry]) => {
			clearInterval(timer);
			if (!entry.isIntersecting) return;
			if (!alist.children.length) for (let k = 0; k < 3; k++) push();
			timer = window.setInterval(push, 1800);
		}).observe(alist);
	}

	/* ----- Magic Card spotlight: a soft glow and border light that follow the pointer ----- */
	if (!reduceMotion) {
		document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((card) => {
			card.addEventListener('pointermove', (e) => {
				const box = card.getBoundingClientRect();
				card.style.setProperty('--mx', `${e.clientX - box.left}px`);
				card.style.setProperty('--my', `${e.clientY - box.top}px`);
			});
		});
	}

	/* ----- Industries: hovering or focusing a row swaps the preview image ----- */
	const ind = document.querySelector<HTMLElement>('[data-ind]');

	if (ind) {
		const items = [...ind.querySelectorAll<HTMLElement>('[data-ind-item]')];
		const figures = [...ind.querySelectorAll<HTMLElement>('[data-ind-media]')];

		const activate = (i: number) => {
			items.forEach((el, n) => el.classList.toggle('is-active', n === i));
			figures.forEach((el, n) => el.classList.toggle('is-active', n === i));
		};

		items.forEach((item, i) => {
			item.addEventListener('pointerenter', () => activate(i));
			item.addEventListener('focus', () => activate(i));
		});
	}
</script>
