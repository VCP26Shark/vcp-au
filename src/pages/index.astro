---

<Layout
	title="VCPility | Automate Your Business. Focus on Growth."
	description="Australia's leading AI automation platform. Consolidate your CRM, chatbots, reviews & marketing into one powerful system. Get more done with less effort."
	keywords="AI, automation, business growth platform, CRM"
>
	<!-- ============================================
	     Hero
	     ============================================ -->
	<section class="hero grid-bg">
		<div class="hero__container">
			<div class="hero__content">
				<p class="eyebrow hero__eyebrow">AI-Powered Automation</p>

				<h1 class="hero__title" aria-label="Stop drowning in admin. Start growing your business.">
					{
						heroTitle.map(([text, mark], i) => (
							<span class="line" style={`--i: ${i}`} aria-hidden="true">
								<span class="line__inner">
									{text}
									{mark && <span class="mark">{mark}</span>}
								</span>
							</span>
						))
					}
				</h1>

				<p class="hero__subtitle">
					You didn't start your business to chase leads or spend weekends on paperwork. Let AI
					handle the busy work while you focus on what you do best.
				</p>

				<div class="hero__buttons">
					<a href="#three-steps" class="btn btn--dark">
						See How It Works
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
					</a>
					<a href="/contact" class="btn btn--link">
						Book Free Strategy Call
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
					</a>
				</div>

				<dl class="hero__stats">
					{
						heroStats.map(({ value, suffix, decimals = 0, label }) => (
							<div class="hero__stat">
								<dt class="hero__stat-label">{label}</dt>
								<dd
									class="hero__stat-value"
									data-count={value}
									data-decimals={decimals}
									data-suffix={suffix}
									data-count-delay="900"
								>
									{value.toFixed(decimals)}
									{suffix}
								</dd>
							</div>
						))
					}
				</dl>
			</div>

			<div class="hero__visual" data-pause-offscreen>
				<div class="hero__accent"></div>

				<div
					class="hero__frame"
					role="region"
					aria-roledescription="carousel"
					aria-label="VCPility features"
					data-hero-carousel
				>
					<span class="hero__corner hero__corner--tl"></span>
					<span class="hero__corner hero__corner--tr"></span>
					<span class="hero__corner hero__corner--bl"></span>
					<span class="hero__corner hero__corner--br"></span>

					<div class="hero__track" data-hero-track>
						{
							heroTrack.map(({ image, title, subtitle, icon }, i) => {
								const isClone = i === heroSlides.length;
								return (
									<div
										class="hero__slide"
										role="group"
										aria-roledescription="slide"
										aria-label={`${i + 1} of ${heroSlides.length}`}
										aria-hidden={i === 0 ? undefined : 'true'}
									>
										<div class="hero__slide-image">
											<Image
												src={image}
												alt={isClone ? '' : title}
												width={960}
												widths={[480, 960]}
												sizes="440px"
												loading="eager"
												fetchpriority={i === 0 ? 'high' : 'low'}
											/>
										</div>
										<div class="hero__caption">
											<span class="hero__caption-icon">
												<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
											</span>
											<span class="hero__caption-text">
												<span class="hero__caption-title">{title}</span>
												<span class="hero__caption-subtitle">{subtitle}</span>
											</span>
										</div>
									</div>
								);
							})
						}
					</div>

					<span class="hero__progress" data-hero-progress></span>
				</div>

				<div class="hero__card hero__card--leads">
					<span class="hero__card-icon">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
							<polyline points="22 4 12 14.01 9 11.01"></polyline>
						</svg>
					</span>
					<span>
						<span class="hero__card-value">117</span>
						<span class="hero__card-label">Leads This Week</span>
					</span>
				</div>

				<div class="hero__card hero__card--active">
					<span class="hero__card-icon">
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.clock} />
					</span>
					<span>
						<span class="hero__card-value">24/7</span>
						<span class="hero__card-label">Always Active</span>
					</span>
				</div>
			</div>
		</div>
	</section>

	<script>
		/* Hero: carousel steps through the slides, with a progress rule timing each one */
		const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
		const track = carousel?.querySelector<HTMLElement>('[data-hero-track]');
		const bar = carousel?.querySelector<HTMLElement>('[data-hero-progress]');

		if (carousel && track && bar) {
			const INTERVAL = 4000;
			const slides = [...track.children] as HTMLElement[];
			const last = slides.length - 1; // index of the clone of the first slide
			let index = 0;
			let hovered = false;
			let inView = true;

			const moveTo = (next: number) => {
				index = next;
				track.style.transform = `translateX(${-index * 100}%)`;
				slides.forEach((slide, i) => slide.setAttribute('aria-hidden', String(i !== index)));
			};

			const progress = bar.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], {
				duration: INTERVAL,
				easing: 'linear',
			});

			const sync = () => {
				if (hovered || !inView || document.hidden) progress.pause();
				else progress.play();
			};

			progress.onfinish = () => {
				// Sitting on the clone looks identical to slide one, so jump back without animating
				if (index === last) {
					track.style.transition = 'none';
					moveTo(0);
					void track.offsetWidth;
					track.style.transition = '';
				}
				moveTo(index + 1);
				progress.currentTime = 0;
				sync();
			};

			carousel.addEventListener('pointerenter', () => {
				hovered = true;
				sync();
			});
			carousel.addEventListener('pointerleave', () => {
				hovered = false;
				sync();
			});
			document.addEventListener('visibilitychange', sync);
			new IntersectionObserver(([entry]) => {
				inView = entry.isIntersecting;
				sync();
			}).observe(carousel);
		}
	</script>

	<!-- ============================================
	     Pain points
	     ============================================ -->
	<section class="pain grid-bg">
		<div class="pain__container">
			<header class="pain__header">
				<p class="eyebrow reveal">Sound Familiar?</p>

				<h2 class="section-title reveal-lines" style="--d: 0.1s">
					{
						painTitle.map(([text, mark], i) => (
							<span class="line" style={`--i: ${i}`}>
								<span class="line__inner">
									{text}
									{mark && <span class="mark">{mark}</span>}
								</span>
							</span>
						))
					}
				</h2>

				<p class="section-lead reveal" style="--d: 0.3s">
					Every day, brilliant business owners like you lose hours to tasks that never seem to end.
					It's exhausting, frustrating, and holds you back from real growth.
				</p>
			</header>

			<ul class="pain__grid">
				{
					painPoints.map(({ title, desc, icon }, i) => (
						<li class="reveal" style={`--d: ${i * 0.08}s`}>
							<article class="pain__card">
								<span class="pain__num" aria-hidden="true">
									{String(i + 1).padStart(2, '0')}
								</span>
								<span class="pain__icon">
									<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
								</span>
								<h3 class="pain__card-title">{title}</h3>
								<p class="pain__card-desc">{desc}</p>
							</article>
						</li>
					))
				}
			</ul>

			<div class="pain__cta reveal">
				<a href="/contact" class="btn btn--yellow">
					See How We Fix This
					<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
				</a>
			</div>
		</div>
	</section>

	<!-- ============================================
	     Daily struggle
	     ============================================ -->
	<section class="struggle grid-bg">
		<div class="struggle__container">
			<header class="struggle__header">
				<p class="eyebrow eyebrow--center reveal">The Daily Struggle</p>

				<h2 class="section-title section-title--compact reveal-lines" style="--d: 0.1s">
					<span class="line">
						<span class="line__inner">You're Drowning in <span class="mark">Busywork</span></span>
					</span>
				</h2>

				<p class="section-lead reveal" style="--d: 0.25s">
					While you're juggling admin tasks, your competitors are closing deals. Every hour spent on
					manual work is revenue slipping through your fingers.
				</p>

				<div class="struggle__cta reveal" style="--d: 0.35s">
					<a href="/features" class="btn btn--yellow btn--compact">
						View All Features
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
					</a>
				</div>
			</header>

			<div class="struggle__content">
				<ul class="struggle__list">
					{
						struggles.map(({ title, desc, value, prefix = '', suffix = '', decimals = 0 }, i) => (
							<li class="struggle__item reveal" style={`--d: ${0.1 + i * 0.1}s`}>
								<span class="struggle__indicator"></span>
								<span class="struggle__item-body">
									<strong class="struggle__item-title">{title}</strong>
									<span class="struggle__item-desc">{desc}</span>
								</span>
								<span
									class="struggle__stat"
									data-count={value}
									data-decimals={decimals}
									data-prefix={prefix}
									data-suffix={suffix}
								>
									{prefix}
									{value.toFixed(decimals)}
									{suffix}
								</span>
							</li>
						))
					}
				</ul>

				<div class="struggle__visual reveal" style="--d: 0.2s" data-pause-offscreen>
					<p class="struggle__status">
						<span class="struggle__status-dot"></span>
						Your Day Without Automation
					</p>

					<div class="struggle__stage" aria-hidden="true">
						<svg class="struggle__lines" viewBox="0 0 500 420" preserveAspectRatio="none">
							{struggleLines.map((d) => <path d={d} />)}
						</svg>

						<div class="struggle__device">
							<div class="struggle__screen">
								<div class="struggle__statusbar">
									<span>9:41</span>
									<span class="struggle__island"></span>
									<span class="struggle__battery"></span>
								</div>
								<div class="struggle__device-bar">
									<span class="struggle__device-dots"><span></span><span></span><span></span></span>
									<span class="struggle__device-title">Your Day</span>
								</div>
								<div class="struggle__device-body">
									<span class="struggle__emoji">😰</span>
									<span class="struggle__device-text">Overwhelmed</span>
									<span class="struggle__bars">
										<span style="--w: 85%; --n: 0"></span>
										<span style="--w: 60%; --n: 1"></span>
										<span style="--w: 40%; --n: 2"></span>
									</span>
								</div>
								<span class="struggle__home"></span>
							</div>
						</div>

						{
							notifications.map(({ count, title, meta, icon }, i) => (
								<div class={`struggle__notif struggle__notif--${i + 1}`} style={`--i: ${i}`}>
									<span class="struggle__notif-badge">{count}</span>
									<span class="struggle__notif-icon">
										<svg viewBox="0 0 24 24" set:html={icon} />
									</span>
									<span class="struggle__notif-text">
										<strong>{title}</strong>
										<span>{meta}</span>
									</span>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================
	     How it works
	     ============================================ -->
	<section class="hiw grid-bg" id="three-steps">
		<div class="hiw__container">
			<header class="hiw__header">
				<p class="eyebrow eyebrow--center reveal">Simple as 1-2-3</p>

				<h2 class="section-title section-title--compact reveal-lines" style="--d: 0.1s">
					<span class="line">
						<span class="line__inner">Get Your Time Back in <span class="mark">3 Steps</span></span>
					</span>
				</h2>

				<p class="section-lead reveal" style="--d: 0.25s">
					No tech skills needed. We handle the setup. You enjoy the results.
				</p>
			</header>

			<ol class="hiw__steps" role="list" data-reveal data-pause-offscreen>
				{
					steps.map(({ title, desc }, i) => (
						<li class="reveal" style={`--d: ${0.1 + i * 0.12}s; --i: ${i}`}>
							<div class="hiw__step">
								<span class="hiw__num" aria-hidden="true">
									{i + 1}
								</span>
								<h3 class="hiw__title">{title}</h3>
								<p class="hiw__desc">{desc}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ============================================
	     Features
	     ============================================ -->
	<section class="features grid-bg">
		<div class="features__container">
			<header class="features__header">
				<div class="features__intro">
					<p class="eyebrow reveal">Platform Features</p>

					<h2 class="section-title section-title--sm reveal-lines" style="--d: 0.1s">
						<span class="line" style="--i: 0"><span class="line__inner">Everything You Need,</span></span>
						<span class="line" style="--i: 1">
							<span class="line__inner"><span class="mark">One Platform</span></span>
						</span>
					</h2>

					<p class="features__lead reveal" style="--d: 0.25s">
						<strong>20+ business management tools</strong> — all in one easy-to-use platform.
					</p>
				</div>

				<div class="features__cta reveal" style="--d: 0.3s">
					<a href="/features" class="btn btn--yellow btn--compact">
						View All Features
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
					</a>
				</div>
			</header>

			<ul class="bento">
				{
					features.map(({ size, variant, label, title, href, desc, list, icon }, i) => (
						<li class={`bento__item bento__item--${size} reveal`} style={`--d: ${0.1 + i * 0.06}s`}>
							<a href={href} class:list={['tile', variant && `tile--${variant}`]}>
								<span class="tile__icon">
									<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
								</span>
								<span class="tile__label">{label}</span>
								<h3 class="tile__title">{title}</h3>
								<p class="tile__desc">{desc}</p>
								{list && (
									<ul class="tile__list">
										{list.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								)}
								<span class="tile__more">
									Learn more
									<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
								</span>
								<span class="tile__num" aria-hidden="true">
									{String(i + 1).padStart(2, '0')}
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ============================================
	     Stats band
	     ============================================ -->
	<section class="stats" data-reveal>
		<dl class="stats__grid">
			{
				bandStats.map(({ value, suffix = '', text, label }, i) => (
					<div class="stats__item reveal" style={`--d: ${i * 0.1}s`}>
						<dt class="stats__label">{label}</dt>
						{value === undefined ? (
							<dd class="stats__value mesh-text">{text}</dd>
						) : (
							<dd
								class="stats__value mesh-text"
								data-count={value}
								data-suffix={suffix}
								data-count-delay={i * 150}
							>
								{value}
								{suffix}
							</dd>
						)}
					</div>
				))
			}
		</dl>
	</section>

	<!-- ============================================
	     Testimonials
	     ============================================ -->
	<section class="testimonials grid-bg">
		<div class="testimonials__container">
			<header class="testimonials__header">
				<p class="eyebrow eyebrow--center reveal">Real Results</p>

				<h2 class="section-title section-title--sm reveal-lines" style="--d: 0.1s">
					<span class="line">
						<span class="line__inner">Businesses Like Yours Are <span class="mark">Thriving</span></span>
					</span>
				</h2>

				<p class="section-lead reveal" style="--d: 0.25s">
					Don't just take our word for it. Here's what our clients say.
				</p>

				<div class="testimonials__cta reveal" style="--d: 0.35s">
					<a href="/contact" class="btn btn--yellow btn--compact">
						Get Results Like These
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
					</a>
				</div>
			</header>

			<ul class="testimonials__grid">
				{
					testimonials.map(({ quote, name, role }, i) => (
						<li class="reveal" style={`--d: ${i * 0.1}s`}>
							<figure class="quote-card">
								<span class="quote-card__mark" aria-hidden="true">
									“
								</span>
								<blockquote class="quote-card__text">
									<p>{quote}</p>
								</blockquote>
								<figcaption class="quote-card__author">
									<span class="quote-card__avatar" aria-hidden="true">
										{name.replace(/^Dr\.\s*/, '')[0]}
									</span>
									<span>
										<strong>{name}</strong>
										<span>{role}</span>
									</span>
								</figcaption>
								<span class="quote-card__stars" role="img" aria-label="Rated 5 out of 5">
									{Array.from({ length: 5 }, () => (
										<svg viewBox="0 0 20 20" aria-hidden="true">
											<path d={starPath} />
										</svg>
									))}
								</span>
							</figure>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ============================================
	     Industries
	     ============================================ -->
	<section class="industries grid-bg" id="built-for-you">
		<div class="industries__container">
			<header class="industries__header">
				<p class="eyebrow eyebrow--center reveal">Built For You</p>

				<h2 class="section-title section-title--sm reveal-lines" style="--d: 0.1s">
					<span class="line">
						<span class="line__inner">We Speak Your <span class="mark">Industry's Language</span></span>
					</span>
				</h2>

				<p class="section-lead reveal" style="--d: 0.25s">
					Custom solutions designed for how your business actually works.
				</p>
			</header>

			<ul class="industries__grid">
				{
					industries.map(({ title, desc, photo, icon }, i) => (
						<li class="reveal" style={`--d: ${0.1 + i * 0.08}s`}>
							<a href="/contact" class:list={['ind-card', !photo && 'ind-card--no-photo']}>
								{photo && (
									<Image
										class="ind-card__photo"
										src={photo}
										alt=""
										width={960}
										widths={[480, 960]}
										sizes="(max-width: 768px) 92vw, (max-width: 1024px) 46vw, 420px"
									/>
								)}
								<span class="ind-card__num mesh-text" aria-hidden="true">
									{String(i + 1).padStart(2, '0')}
								</span>
								<span class="ind-card__content">
									<span class="ind-card__icon">
										<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
									</span>
									<h3 class="ind-card__title">{title}</h3>
									<p class="ind-card__desc">{desc}</p>
								</span>
								<span class="ind-card__arrow" aria-hidden="true">
									<svg viewBox="0 0 24 24" set:html={arrow} />
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>
