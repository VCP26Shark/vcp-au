---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import '../styles/pages/home.css';

import booking from '../assets/home/hero/booking.webp';
import mobileApp from '../assets/home/hero/mobile-app.webp';
import chatbot from '../assets/home/hero/chatbot.webp';
import crm from '../assets/home/hero/crm.webp';
import dashboard from '../assets/home/hero/dashboard.webp';
import website from '../assets/home/hero/website.webp';
import reviews from '../assets/home/hero/reviews.webp';
import reactivation from '../assets/home/hero/reactivation.webp';

import accountingPhoto from '../assets/home/industries/accounting.jpg';
import ndisPhoto from '../assets/home/industries/ndis.jpg';
import realEstatePhoto from '../assets/home/industries/real-estate.jpg';
import solarPhoto from '../assets/home/industries/solar.jpg';
import dentalPhoto from '../assets/home/industries/dental.jpg';
import wellnessPhoto from '../assets/home/industries/wellness.jpg';
import tradesPhoto from '../assets/home/industries/trades.jpg';

/* Homepage v2: the same content and flow as index.astro in a modern editorial
   style. Inter throughout, white space and hairline rules, navy ink and the
   five logo colours as small accents. Effects are ported (dependency-free)
   from Magic UI, Aceternity UI and React Bits. */

const arrow = '<path d="M5 12h14M12 5l7 7-7 7"/>';

// Icons used by more than one section
const icons = {
	calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
	chat: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
	users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
	star: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
	clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
	mobile: '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/>',
	chart: '<path d="M3 3v18h18"/><path d="M18 17V9M13 17V5M8 17v-3"/>',
	phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
};

const pad = (n: number) => String(n).padStart(2, '0');

// The logo's five colour bars, used as small accents (index 0-4 maps to --brand-1 … --brand-5)
const brand = (i: number) => `var(--brand-${(i % 5) + 1})`;

/* ----- Hero ----- */

// The first sentence blurs in word by word; the second, in a white-to-pink gradient, line by line
const heroLines = ['Stop Drowning', 'in Admin.', 'Start Growing', 'Your Business.'];

const heroStats = [
	{ value: 15, suffix: '+', label: 'Hours Saved Weekly' },
	{ value: 98, suffix: '%', label: 'Response Rate' },
	{ value: 2.4, suffix: 'x', decimals: 1, label: 'More Leads' },
];

const heroSlides = [
	{
		image: booking,
		title: 'Online Appointment Booking Calendar',
		subtitle: '24/7 Automated Scheduling',
		icon: icons.calendar,
	},
	{
		image: mobileApp,
		title: 'Mobile App',
		subtitle: 'Manage Business On-the-Go',
		icon: icons.mobile,
	},
	{
		image: chatbot,
		title: 'AI Chatbot',
		subtitle: 'Instant Lead Engagement',
		icon: icons.chat,
	},
	{
		image: crm,
		title: 'All-in-One CRM',
		subtitle: 'Unified Customer Management',
		icon: icons.users,
	},
	{
		image: dashboard,
		title: 'AI-Powered Dashboard',
		subtitle: 'Real-Time Business Insights',
		icon: icons.chart,
	},
	{
		image: website,
		title: 'StoryBrand Website',
		subtitle: 'Conversion-Optimized Design',
		icon: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
	},
	{
		image: reviews,
		title: 'Review & Reputation Management',
		subtitle: '5-Star Rating Automation',
		icon: icons.star,
	},
	{
		image: reactivation,
		title: 'Recall, Retention & Reactivation',
		subtitle: 'Automated Win-Back Campaigns',
		icon: '<polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>',
	},
];

// The first slide is repeated at the end so the loop can wrap seamlessly
const heroTrack = [...heroSlides, heroSlides[0]];

/* ----- Pain points ----- */

const painTitle = ["You're Great at What You Do.", 'But the Business Side?', 'Exhausting.'];

const painLead =
	"Every day, brilliant business owners like you lose hours to tasks that never seem to end. It's exhausting, frustrating, and holds you back from real growth.";

const painPoints = [
	{
		title: 'Leads Slipping Away',
		art: 'calls',
		desc: 'Another missed call. Another lead gone to your competitor who answered first.',
		icon: icons.phone + '<path d="m23 1-6 6M17 1l6 6"/>',
	},
	{
		title: 'Nights & Weekends',
		art: 'clock',
		desc: 'Catching up on admin when you should be resting.',
		icon: '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>',
	},
	{
		title: 'Firefighting',
		art: 'tasks',
		desc: 'Stuck in survival mode.',
		icon: '<path d="M12 2c.5 2.5 2 4.5 2 6.5a4 4 0 0 1-8 0c0-2 1.5-4 2-6.5C7 5 4 8 4 12a8 8 0 0 0 16 0c0-4-3-7-8-10z"/>',
	},
	{
		title: 'Money Left Behind',
		art: 'bars',
		desc: 'No follow-up system means lost revenue opportunities.',
		icon: '<path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
	},
	{
		title: 'Tool Overload',
		art: 'apps',
		desc: "10 apps that don't talk to each other. Nothing syncs properly.",
		icon: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
	},
	{
		title: 'Review Anxiety',
		art: 'stars',
		desc: 'Bad reviews linger.',
		icon: '<path d="M11.05 2.93c.3-.92 1.6-.92 1.9 0l1.52 4.67a1 1 0 0 0 .95.7h4.91c.97 0 1.37 1.24.59 1.8l-3.97 2.9a1 1 0 0 0-.37 1.11l1.52 4.68c.3.92-.76 1.69-1.54 1.12l-3.98-2.89a1 1 0 0 0-1.17 0l-3.98 2.89c-.78.57-1.84-.2-1.54-1.12l1.52-4.68a1 1 0 0 0-.36-1.11L3.03 10.1c-.78-.57-.38-1.81.59-1.81h4.91a1 1 0 0 0 .95-.69z"/><path d="m4 4 16 16"/>',
	},
];

// Small illustrations inside the pain cards
const missedCalls = ['4:41 pm', '3:02 pm', '2:14 pm'];
const urgentTasks = ['Chase unpaid invoice', 'Fix double booking', 'Call back lead'];
const shrinkingBars = [92, 74, 60, 41, 24];
const appTiles = [
	{ icon: icons.calendar, x: 8, y: 14 },
	{ icon: icons.chat, x: 30, y: 52 },
	{ icon: icons.users, x: 50, y: 8 },
	{ icon: icons.star, x: 70, y: 46 },
	{ icon: icons.clock, x: 88, y: 12 },
	{ icon: icons.mobile, x: 12, y: 78 },
	{ icon: icons.chart, x: 58, y: 82 },
	{ icon: icons.phone, x: 86, y: 76 },
];
// Dashed links between tiles (indexes into appTiles); the last one is broken
const appLinks = [
	[0, 1],
	[1, 2],
	[2, 3],
	[3, 4],
	[1, 5],
	[3, 6],
	[6, 7],
];

/* ----- Daily struggle ----- */

const struggles = [
	{ title: 'Missed calls & slow responses', desc: 'Leads go cold within 5 minutes', value: 78, suffix: '%' },
	{ title: 'Hours lost to repetitive tasks', desc: 'Every single week', value: 15, suffix: '+' },
	{ title: 'Revenue from poor follow-up', desc: 'Left on the table annually', value: 47, prefix: '$', suffix: 'K' },
	{ title: 'Disconnected tools & apps', desc: 'Creating data silos', value: 10, suffix: '+' },
	{ title: 'Bad reviews without response', desc: 'Damaging your reputation', value: 3.2, decimals: 1, suffix: '★' },
];

const notifications = [
	{ count: 5, title: 'Missed Calls', meta: 'New leads waiting', icon: icons.phone },
	{
		count: 47,
		title: 'Unread Emails',
		meta: 'Waiting for reply',
		icon: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>',
	},
	{ count: 3, title: 'Bad Reviews', meta: 'Needs response', icon: icons.star },
	{ count: 8, title: 'Overdue Quotes', meta: 'Clients waiting', icon: icons.clock },
	{ count: 12, title: 'Lost Leads', meta: 'Went to competitors', icon: icons.users },
	{ count: 4, title: 'Double-Booked', meta: 'Schedule conflict', icon: icons.calendar },
	{ count: 23, title: 'Unanswered', meta: "Where's my invoice?", icon: icons.chat },
];

/* ----- How it works ----- */

const steps = [
	{
		title: 'Tell Us Your Goals',
		desc: 'Quick strategy call to understand your business, challenges, and what success looks like for you.',
	},
	{
		title: 'We Build Your System',
		desc: 'Our team sets up your AI-powered automation, customised exactly to how your business works.',
	},
	{
		title: 'Watch Your Business Grow',
		desc: 'Sit back and relax as leads convert, bookings fill up, and reviews roll in – all on autopilot.',
	},
];

/* ----- Features: each card gets a small live illustration (art) ----- */

const dots = (y: number) => `<path d="M8 ${y}h.01M12 ${y}h.01M16 ${y}h.01"/>`;

const features = [
	{
		art: 'orbit',
		label: 'Core Feature',
		title: 'All-in-One CRM',
		href: '/features#crm',
		desc: 'Manage leads, track deals, and nurture customer relationships from a single powerful dashboard.',
		list: ['Contact Management', 'Pipeline Tracking', 'Deal Insights'],
		icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
	},
	{
		art: 'chat',
		label: 'Automation',
		title: 'AI Chatbot',
		href: '/features#chatbot',
		desc: 'Engage visitors 24/7 with intelligent conversations that qualify leads and book appointments.',
		icon: icons.chat + dots(10),
	},
	{
		art: 'calendar',
		label: 'Scheduling',
		title: 'Smart Booking',
		href: '/features#smart-booking',
		desc: 'Automated scheduling with reminders.',
		icon: icons.calendar + dots(14),
	},
	{
		art: 'phone',
		label: 'On The Go',
		title: 'Mobile App',
		href: '/features#mobile-app',
		desc: 'Manage your business from anywhere.',
		icon: icons.mobile,
	},
	{
		art: 'bars',
		label: 'Analytics',
		title: 'AI Dashboard',
		href: '/features#ai-dashboard',
		desc: 'Real-time insights and performance tracking to make smarter business decisions.',
		icon: icons.chart,
	},
];

// Icons circling the CRM card: [icon, ring, start angle]
const orbitIcons: [string, 'inner' | 'outer', number][] = [
	[icons.chat, 'inner', 0],
	[icons.calendar, 'inner', 120],
	[icons.star, 'inner', 240],
	[icons.phone, 'outer', 30],
	[icons.mobile, 'outer', 150],
	[icons.chart, 'outer', 270],
];

// Illustrative copy for the chatbot card (decorative, hidden from assistive tech)
const chatLines = [
	{ from: 'them', text: 'Do you have anything Thursday?' },
	{ from: 'bot', text: 'Yes, 10:30am is free. Shall I book it?' },
	{ from: 'them', text: 'Perfect, thanks!' },
];

const bookedDays = [3, 5, 8, 9, 12, 16, 17, 19, 23, 24, 26, 30];
const today = 18;
const bars = [38, 52, 44, 68, 60, 82, 74, 96];

/* ----- Stats band ----- */

const bandStats = [
	{ value: 32, suffix: '%', label: 'Time Saved Weekly' },
	{ text: '24/7', label: 'Lead Response' },
	{ value: 22, suffix: '%', label: 'Cost Savings' },
	{ value: 6, suffix: '+', label: 'Industries Served' },
];

/* ----- Testimonials ----- */

const testimonials = [
	{
		quote:
			"I used to spend 3 hours every night on follow-ups. Now the AI handles it while I'm with my family. Best investment I've made for my business.",
		name: 'Michael T.',
		role: 'Solar Installation Business',
	},
	{
		quote:
			"Our bookings increased by 40% in the first month. The chatbot answers questions and books appointments even when we're with patients.",
		name: 'Dr. Sarah K.',
		role: 'Dental Practice Owner',
	},
	{
		quote:
			'Finally, I have a system that works. No more lost leads, no more forgotten follow-ups. My stress levels have dropped dramatically.',
		name: 'James R.',
		role: 'Real Estate Agent',
	},
];

const starPath =
	'M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z';

/* ----- Industries ----- */

const industries = [
	{
		title: 'LYD Accrual OS',
		desc: 'Automate invoicing, reminders, and client workflows with smarter financial operations.',
		photo: accountingPhoto,
	},
	{
		title: 'LYD Assist',
		desc: 'Run your NDIS business with participant management, rostering, and compliance in one suite.',
		// Unsplash photo Zx4ddAfk0Ck (Unsplash License)
		photo: ndisPhoto,
	},
	{
		title: 'LYD Solar',
		desc: 'Convert inquiries to installations with automated quote delivery and smart scheduling.',
		photo: solarPhoto,
	},
	{
		title: 'Real Estate',
		desc: 'Never miss a lead. Automate follow-ups and fill your calendar with qualified buyers.',
		photo: realEstatePhoto,
	},
	{
		title: 'Dental',
		desc: 'Fill your chairs with smart appointment reminders and review management.',
		photo: dentalPhoto,
	},
	{
		title: 'Wellness',
		desc: 'Nurture client relationships with personalized follow-ups and membership management.',
		photo: wellnessPhoto,
	},
	{
		title: 'Trades',
		desc: 'Streamline job requests, dispatch teams efficiently, and get paid faster.',
		photo: tradesPhoto,
	},
];
---

<Layout
	title="VCPility | Automate Your Business. Focus on Growth."
	description="Australia's leading AI automation platform. Consolidate your CRM, chatbots, reviews & marketing into one powerful system. Get more done with less effort."
	keywords="AI, automation, business growth platform, CRM"
>
	<!-- ============================================
	     Hero: word-by-word headline (Magic UI Text Animate)
	     ============================================ -->
	<section class="hero2">
		<div class="container">
			<div class="hero2__panel" data-pause-offscreen data-hero-panel>
				<canvas class="shader" aria-hidden="true" data-shader></canvas>
				<span class="hero2__lines" aria-hidden="true"></span>
				<span class="hero2__spot" aria-hidden="true"></span>
				<span class="beam" aria-hidden="true"></span>

				<div class="hero2__content">
					<div class="hero2__copy">
						<p class="pill reveal">
							<span class="bars" aria-hidden="true"
								><span></span><span></span><span></span><span></span><span></span></span
							>
							AI-Powered Automation
						</p>

						<h1 class="hero2__title" data-reveal aria-label="Stop drowning in admin. Start growing your business.">
							{
								heroLines.map((line, l) =>
									l < 2 ? (
										<span class="hero2__line" aria-hidden="true">
											{line.split(' ').map((word, w) => (
												<span class="word" style={`--i: ${l * 2 + w}`}>
													{word}
												</span>
											))}
										</span>
									) : (
										<span class="hero2__line hero2__line--glow" aria-hidden="true" style={`--i: ${l + 3}`}>
											{line}
										</span>
									),
								)
							}
						</h1>

						<p class="hero2__subtitle reveal" style="--d: 0.25s">
							You didn't start your business to chase leads or spend weekends on paperwork. Let AI handle the busy
							work while you focus on what you do best.
						</p>

						<div class="hero2__buttons reveal" style="--d: 0.3s">
							<a href="#three-steps" class="btn btn--light btn--shine" data-magnetic>
								See How It Works
								<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
							</a>
							<a href="/contact" class="btn btn--link btn--on-ink">
								Book Free Strategy Call
								<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
							</a>
						</div>
					</div>

					<!-- Product carousel that tilts with the pointer, with the stats floating around it -->
					<div class="hero2__stage" data-tilt>
						<div class="hero2__tilt">
							<div
								class="hero2__frame reveal"
								style="--d: 0.1s"
								role="region"
								aria-roledescription="carousel"
								aria-label="VCPility features"
								data-hero-carousel
							>
								<div class="hero2__track" data-hero-track>
									{
										heroTrack.map(({ image, title, subtitle, icon }, i) => {
											const isClone = i === heroSlides.length;
											return (
												<div
													class="hero2__slide"
													role="group"
													aria-roledescription="slide"
													aria-label={`${(i % heroSlides.length) + 1} of ${heroSlides.length}`}
													aria-hidden={i === 0 ? undefined : 'true'}
												>
													<div class="hero2__slide-image">
														<Image
															src={image}
															alt={isClone ? '' : title}
															width={960}
															widths={[480, 960]}
															sizes="(max-width: 1024px) 90vw, 600px"
															loading={i === 0 ? 'eager' : 'lazy'}
															fetchpriority={i === 0 ? 'high' : 'auto'}
														/>
													</div>
													<div class="hero2__caption">
														<span class="hero2__caption-icon">
															<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
														</span>
														<span class="hero2__caption-text">
															<span class="hero2__caption-title">{title}</span>
															<span class="hero2__caption-subtitle">{subtitle}</span>
														</span>
														<span class="hero2__caption-num">
															{pad((i % heroSlides.length) + 1)}/{pad(heroSlides.length)}
														</span>
													</div>
												</div>
											);
										})
									}
								</div>
								<span class="hero2__progress" data-hero-progress></span>
							</div>

							<dl class="hero2__chips">
								{
									heroStats.map(({ value, suffix, decimals = 0, label }, i) => (
										<div
											class="hero2__chip reveal"
											style={`--d: ${0.45 + i * 0.12}s; --b: ${i * -2}s; --c: ${brand(i * 2)}`}
										>
											<dt>{label}</dt>
											<dd class="ticker" data-ticker data-reveal style={`--d: ${0.5 + i * 0.12}s`}>
												{value.toFixed(decimals)}
												{suffix}
											</dd>
										</div>
									))
								}
							</dl>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ----- Capabilities: two rows that speed up and flip with scrolling (Magic UI Scroll Based Velocity).
	     Each track is rendered twice so it can wrap seamlessly. ----- -->
	<div class="velocity" aria-hidden="true">
		<div class="velocity__row velocity__row--lg" data-velocity="1">
			<div class="velocity__track">
				{
					[0, 1].map(() =>
						heroSlides.map(({ title }, i) => (
							<span class="velocity__item">
								{title}
								<span class="velocity__dot" style={`background: ${brand(i)}`} />
							</span>
						)),
					)
				}
			</div>
		</div>
		<div class="velocity__row velocity__row--sm" data-velocity="-1">
			<div class="velocity__track">
				{
					[0, 1].map(() =>
						heroSlides.map(({ subtitle, icon }) => (
							<span class="velocity__item">
								<svg viewBox="0 0 24 24" set:html={icon} />
								{subtitle}
							</span>
						)),
					)
				}
			</div>
		</div>
	</div>

	<!-- ============================================
	     01 Pain points: lead reads in as you scroll (Magic UI Text Reveal)
	     ============================================ -->
	<section class="chapter pain">
		<div class="container">
			<p class="label reveal"><span class="label__num">01</span>Sound Familiar?</p>

			<h2 class="display reveal-lines" style="--d: 0.1s">
				{
					painTitle.map((text, i) => (
						<span class="line" style={`--i: ${i}`}>
							<span class:list={['line__inner', i === painTitle.length - 1 && 'muted']}>{text}</span>
						</span>
					))
				}
			</h2>

			<p class="scroll-text" data-scroll-text>
				{
					painLead.split(' ').map((word, i, all) => (
						<span class="w" style={`--w: ${(i / all.length).toFixed(3)}`}>
							{word}{' '}
						</span>
					))
				}
			</p>

			<ul class="pain__grid">
				{
					painPoints.map(({ title, desc, icon, art }, i) => (
						<li class:list={['pain__item', `pain__item--${art}`, 'reveal']} style={`--d: ${(i % 3) * 0.08}s`}>
							<div class="pain__head">
								<span class="pain__num">{pad(i + 1)}</span>
								<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} data-draw />
							</div>

							<div class="pain__art" aria-hidden="true">
								{art === 'calls' &&
									missedCalls.map((time, k) => (
										<div class="pa-call" style={`--k: ${k}`}>
											<span class="pa-call__icon">
												<svg viewBox="0 0 24 24" set:html={icons.phone + '<path d="m23 1-6 6M17 1l6 6"/>'} />
											</span>
											<span class="pa-call__text">
												<strong>Missed call</strong>
												<span>New enquiry · {time}</span>
											</span>
										</div>
									))}

								{art === 'clock' && (
									<div class="pa-clock">
										<strong>
											11<span class="pa-clock__colon">:</span>48
										</strong>
										<span>pm · Saturday</span>
									</div>
								)}

