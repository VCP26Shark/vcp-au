---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/reference-check.css';

const lock = '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>';
const formId = 'rlGLqKtmafhH5zpsyZ8t';
---

<Layout
	title="Candidate Reference Check | VCPility"
	description="Confidential reference check for candidates joining Sharktech Global."
	noindex
>
	<!-- ============================================
	     Reference check
	     ============================================ -->
	<section class="refcheck grid-bg">
		<div class="refcheck__container">
			<header class="refcheck__header">
				<p class="eyebrow reveal">Candidate Reference Check</p>

				<h1 class="section-title section-title--sm reveal-lines" style="--d: 0.1s">
					<span class="line">
						<span class="line__inner">Sharktech VCPility Reference Check</span>
					</span>
				</h1>

				<p class="refcheck__intro reveal" style="--d: 0.2s">
					Thanks for taking the time to complete this. <strong>Sharktech Global</strong> is an
					AI-native company focused on artificial intelligence and machine learning R&amp;D, building
					technology for a world being reshaped by AI. We are heading into a funding round, and the
					person you are referencing may work closely with sensitive IP, client data and the core of
					what we are building. Your honest feedback helps us make the right call.
				</p>

				<p class="refcheck__badge reveal" style="--d: 0.3s">
					<svg viewBox="0 0 24 24" aria-hidden="true" set:html={lock} />
					Strictly Confidential
				</p>

				<aside class="refcheck__note reveal" style="--d: 0.35s" aria-labelledby="refcheck-note-label">
					<p class="refcheck__note-label" id="refcheck-note-label">Before You Start</p>
					<p class="refcheck__note-text">
						Sharktech Global is an AI-native company focused on artificial intelligence and machine
						learning R&amp;D. The person you are referencing may be joining a fast-moving team working
						on live products, sensitive IP and client systems across AI, hospitality, industrial safety
						and business growth. We need to know who they really are, not just their best moments.{' '}
						<strong>Please be as honest as you can. Everything you share stays confidential.</strong>
					</p>
				</aside>
			</header>

			<div class="refcheck__form reveal" style="--d: 0.4s">
				<span class="refcheck__corner refcheck__corner--tl" aria-hidden="true"></span>
				<span class="refcheck__corner refcheck__corner--tr" aria-hidden="true"></span>
				<span class="refcheck__corner refcheck__corner--bl" aria-hidden="true"></span>
				<span class="refcheck__corner refcheck__corner--br" aria-hidden="true"></span>

				<!-- LeadConnector form: attributes are read by form_embed.js, which also auto-sizes the iframe -->
				<iframe
					src={`https://api.leadconnectorhq.com/widget/form/${formId}`}
					class="refcheck__iframe"
					id={`inline-${formId}`}
					title="Candidate Reference Check"
					data-layout="{'id':'INLINE'}"
					data-trigger-type="alwaysShow"
					data-trigger-value=""
					data-activation-type="alwaysActivated"
					data-activation-value=""
					data-deactivation-type="neverDeactivate"
					data-deactivation-value=""
					data-form-name="Candidate Reference Check"
					data-height="3990"
					data-layout-iframe-id={`inline-${formId}`}
					data-form-id={formId}></iframe>
			</div>
		</div>
	</section>

	<script is:inline src="https://link.msgsndr.com/js/form_embed.js" async></script>
</Layout>
