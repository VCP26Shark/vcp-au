---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { getPosts, readingTime, formatDate } from '../data/blog';
import '../styles/components/blog.css';
import '../styles/pages/blog.css';

const posts = await getPosts();
const [featured, ...rest] = posts;
const categories = [...new Set(posts.map((post) => post.data.category))];

const pad = (n: number) => String(n).padStart(2, '0');
const arrow = '<path d="M5 12h14M12 5l7 7-7 7"/>';
---

<Layout
	title="Blog | VCPility"
	description="Practical ideas on automation, reviews, websites and growth for Australian small businesses, from the VCPility team."
	keywords="small business automation, Google reviews, speed to lead, website tips, VCPility blog"
>
	<!-- ============================================
	     Hero
	     ============================================ -->
	<section class="page-hero blog-hero">
		<canvas class="blog-hero__grid" aria-hidden="true" data-flicker-grid data-flicker-color="13, 31, 56"></canvas>

		<div class="container">
			<p class="label reveal">
				<span class="bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
				The VCPility Journal
			</p>

			<div class="page-hero__grid">
				<h1 class="page-hero__title reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">Ideas for running</span></span>
					<span class="line" style="--i: 1"><span class="line__inner muted">a smarter business.</span></span>
				</h1>

				<div class="reveal" style="--d: 0.25s">
					<p class="lead">
						Practical, no-jargon advice on automation, reviews, websites and winning more work, written for
						Australian small businesses.
					</p>
					<ul class="blog-hero__topics" aria-label="Topics">
						{categories.map((category) => <li>{category}</li>)}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================
	     01 Featured (latest) post
	     ============================================ -->
	{
		featured && (
			<section class="chapter blog-featured">
				<div class="container">
					<p class="label reveal">
						<span class="label__num">01</span>Latest
					</p>

					<article class="blog-featured__card">
						<a href={`/blog/${featured.id}`} class="blog-featured__media" data-reveal tabindex="-1" aria-hidden="true">
							<span class="blog-featured__frame">
								<Image
									src={featured.data.cover}
									alt=""
									widths={[640, 1000, 1400, 1800]}
									sizes="(max-width: 900px) 90vw, 55vw"
									loading="eager"
								/>
							</span>
						</a>
						<div class="blog-featured__body reveal" style="--d: 0.1s">
							<p class="post-meta">
								<span class="post-meta__label">Latest</span>
								<span>{featured.data.category}</span>
								<time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>
							</p>
							<h2 class="blog-featured__title">
								<a href={`/blog/${featured.id}`}>{featured.data.title}</a>
							</h2>
							<p class="blog-featured__desc">{featured.data.description}</p>
							<a href={`/blog/${featured.id}`} class="btn btn--link" aria-hidden="true" tabindex="-1">
								Read the article · {readingTime(featured)}
								<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
							</a>
						</div>
					</article>
				</div>
			</section>
		)
	}

	<!-- ============================================
	     02 All other posts
	     ============================================ -->
	{
		rest.length > 0 && (
			<section class="chapter blog-list">
				<div class="container">
					<p class="label reveal">
						<span class="label__num">02</span>More articles
					</p>

					<div class="chapter__head">
						<h2 class="display reveal-lines" style="--d: 0.1s">
							<span class="line"><span class="line__inner">From the</span></span>
							<span class="line" style="--i: 1"><span class="line__inner muted">archive.</span></span>
						</h2>
						<p class="lead reveal" style="--d: 0.2s">
							Short reads you can put to work this week, from the team that builds VCPility.
						</p>
					</div>

					<ul class="post-cards">
						{rest.map((post, i) => (
							<li class="reveal" style={`--d: ${(i % 3) * 0.06}s`}>
								<a href={`/blog/${post.id}`} class="card post-card" data-spotlight>
									<span class="post-card__media">
										<Image src={post.data.cover} alt="" widths={[480, 800, 1200]} sizes="(max-width: 768px) 90vw, 30vw" />
									</span>
									<span class="post-card__body">
										<span class="post-meta">
											<span class="post-meta__num">{pad(i + 2)}</span>
											<span>{post.data.category}</span>
											<span>{readingTime(post)}</span>
										</span>
										<span class="post-card__title">{post.data.title}</span>
										<span class="post-card__desc">{post.data.description}</span>
										<time class="post-card__date" datetime={post.data.date.toISOString()}>
											{formatDate(post.data.date)}
										</time>
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<!-- ============================================
	     Closing CTA: shader panel with Ripple rings
	     ============================================ -->
	<section class="finale">
		<div class="container">
			<div class="finale__panel" data-pause-offscreen>
				<canvas class="shader" aria-hidden="true" data-shader></canvas>
				<span class="ripple" aria-hidden="true">
					{[0, 1, 2, 3, 4].map((n) => <span style={`--n: ${n}`} />)}
				</span>

				<div class="finale__inner">
					<span class="bars bars--light reveal" aria-hidden="true"
						><span></span><span></span><span></span><span></span><span></span></span
					>
					<h2 class="finale__title reveal-lines" style="--d: 0.1s">
						<span class="line"><span class="line__inner">Put the ideas</span></span>
						<span class="line" style="--i: 1"><span class="line__inner">to work.</span></span>
					</h2>
					<p class="finale__text reveal" style="--d: 0.3s">
						See how VCPility automates your enquiries, reviews and follow-ups, so your team can get on with the
						work.
					</p>
					<div class="finale__buttons reveal" style="--d: 0.4s">
						<a href="/contact" class="btn btn--light btn--shine" data-magnetic>
							Book a demo
							<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
						</a>
						<a href="/features" class="btn btn--link btn--on-ink">
							Explore the features
							<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
