---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/about.css';

/* ----- Guiding principles ----- */

const person = '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>';

const principles = [
	{
		title: 'Human-Centered Intelligence',
		desc: 'AI that empowers, not replaces. We amplify your creativity and insight.',
		icon: person,
	},
	{
		title: 'Privacy Is Non-Negotiable',
		desc: 'Your trust is worth more than any data we could monetise.',
		icon: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
	},
	{
		title: 'Transparent Systems',
		desc: 'We show how things work - no black boxes, no hidden agendas.',
		icon: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>',
	},
	{
		title: 'Software Is Craft',
		desc: 'Every feature is intentional. Every interface is designed with care.',
		icon: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
	},
];

/* ----- What we actually do ----- */

const purpose = [
	{
		label: 'Our Mission',
		desc: 'To empower businesses with ethical AI-driven marketing that amplifies human potential.',
	},
	{
		label: 'Our Vision',
		desc: 'A future where AI enhances visibility, credibility, and profitability through empowerment.',
	},
	{
		label: 'Our Promise',
		desc: 'Technology that builds trust - growth that is sustainable, not extractive.',
	},
];

/* ----- Icons, CTA + contact ----- */

const arrow = '<path d="M5 12h14M12 5l7 7-7 7"/>';
const down = '<path d="M12 5v14M5 12l7 7 7-7"/>';
const externalIcon = '<path d="M7 17 17 7M8 7h9v9"/>';

const contactCards = [
	{
		label: 'Phone',
		lines: ['+61 468 487 373'],
		href: 'tel:+61468487373',
		icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
	},
	{
		label: 'Location',
		lines: ['244 Macquarie St', 'Liverpool NSW 2170', 'Australia'],
		href: 'https://www.google.com/maps/search/?api=1&query=244+Macquarie+St+Liverpool+NSW+2170',
		external: true,
		icon: '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>',
	},
	{
		label: 'Hours',
		lines: ['Mon–Fri: 9:00 AM – 6:00 PM', 'Weekends: Closed'],
		icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
	},
];
---

<Layout
	title="About Us | VCPility"
	description="VCPility, from Sharktech Global: AI that amplifies human potential for Australian businesses."
>
	<!-- ============================================
	     Hero: headline, then the leadership quote on a shader panel
	     ============================================ -->
	<section class="about-hero">
		<div class="container">
			<p class="eyebrow about-hero__eyebrow reveal">About VCPility</p>
			<h1 class="about-hero__title reveal-lines" style="--d: 0.1s">
				<span class="line"><span class="line__inner">Technology Should</span></span>
				<span class="line" style="--i: 1"><span class="line__inner">Serve People.</span></span>
			</h1>

			<div class="about-hero__row">
				<p class="about-hero__lead reveal" style="--d: 0.35s">
					VCPility was born from a simple but profound belief: that technology should serve people, not the other way
					around.
				</p>
				<a href="#vision" class="btn btn--link reveal" style="--d: 0.45s">
					Our founding vision
					<svg viewBox="0 0 24 24" aria-hidden="true" set:html={down} />
				</a>
			</div>
		</div>

		<figure class="manifesto reveal" style="--d: 0.3s" data-pause-offscreen>
			<canvas class="shader" aria-hidden="true" data-shader></canvas>
			<blockquote class="container">
				<p>
					“We believe artificial intelligence should not replace human potential. It should amplify it. This is not
					just our technology. This is our responsibility.”
				</p>
			</blockquote>
			<figcaption class="container">From Sharktech Global Leadership</figcaption>
		</figure>
	</section>

	<!-- ============================================
	     Founding vision
	     ============================================ -->
	<section class="sec vision" id="vision">
		<div class="container vision__grid">
			<div class="vision__head">
				<p class="eyebrow reveal">Why We Exist</p>
				<h2 class="section-title section-title--sm reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">Our Founding</span></span>
					<span class="line" style="--i: 1"><span class="line__inner">Vision</span></span>
				</h2>
			</div>

			<div class="vision__body">
				<p class="vision__lede reveal">
					VCPility is not just another product from Sharktech Global. It is an extension of our founding philosophy. We
					build AI that <em>empowers humanity, not replaces it</em>, serving with transparency and long-term ethics.
				</p>

				<p class="vision__para reveal" style="--d: 0.1s">
					We believe that <strong>small businesses deserve world-class tools</strong>. For too long, the most powerful AI
					capabilities were locked behind enterprise budgets and technical complexity. We're changing that. Every
					business owner, whether running a real estate agency, a solar installation company or a local service, should
					have access to technology that genuinely amplifies their potential.
				</p>

				<p class="vision__para reveal" style="--d: 0.15s">
					<strong>Privacy is not negotiable</strong>. Your trust is worth more than any data we could monetise. We
					amplify your creativity and insight; we don't replace them. AI should enhance human judgment, not override
					it. And above all, <strong>software is craft, not just code</strong>. Every feature is intentional. Every
					interface is designed with care.
				</p>

				<p class="vision__signature reveal" style="--d: 0.2s">Sharktech Global Leadership</p>
			</div>
		</div>
	</section>

	<!-- ============================================
	     Guiding principles
	     ============================================ -->
	<section class="sec principles">
		<div class="container">
			<header class="sec-head">
				<div>
					<p class="eyebrow reveal">What We Stand For</p>
					<h2 class="section-title section-title--sm reveal-lines" style="--d: 0.1s">
						<span class="line"><span class="line__inner">Our Four Guiding</span></span>
						<span class="line" style="--i: 1"><span class="line__inner">Principles</span></span>
					</h2>
				</div>
				<p class="sec-head__lead reveal" style="--d: 0.25s">
					The commitments behind every feature we ship and every conversation we have with you.
				</p>
			</header>

			<ol class="principles__grid">
				{
					principles.map(({ title, desc, icon }, i) => (
						<li class="principle reveal" style={`--d: ${i * 0.08}s`}>
							<div class="principle__top">
								<span class="principle__num">{String(i + 1).padStart(2, '0')}</span>
								<span class="principle__icon">
									<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
								</span>
							</div>
							<h3>{title}</h3>
							<p>{desc}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ============================================
	     What we actually do
	     ============================================ -->
	<section class="sec purpose">
		<div class="container">
			<header class="sec-head">
				<div>
					<p class="eyebrow reveal">Our Purpose</p>
					<h2 class="section-title section-title--sm reveal-lines" style="--d: 0.1s">
						<span class="line"><span class="line__inner">What We Actually Do</span></span>
					</h2>
				</div>
			</header>

			<dl class="purpose__list">
				{
					purpose.map(({ label, desc }, i) => (
						<div class="purpose__row reveal" style={`--d: ${i * 0.08}s`}>
							<dt>{label}</dt>
							<dd>{desc}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- ============================================
	     CTA (shader band) + contact
	     ============================================ -->
	<section class="about-cta" data-pause-offscreen>
		<canvas class="shader" aria-hidden="true" data-shader></canvas>
		<div class="container about-cta__inner reveal">
			<h2 class="section-title section-title--sm">Join Us in Building Something Better</h2>
			<p class="about-cta__lead">We're offering partnership built on trust, transparency, and long-term value.</p>
			<p class="about-cta__quote">“True success lies in empowerment, not extraction.”</p>
			<a href="/contact" class="btn btn--light btn--shine">
				Get a FREE Quote
				<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
			</a>
		</div>
	</section>

	<section class="sec talk">
		<div class="container">
			<header class="sec-head">
				<div>
					<p class="eyebrow reveal">Get In Touch</p>
					<h2 class="section-title section-title--sm reveal-lines">
						<span class="line"><span class="line__inner">Let's Talk</span></span>
					</h2>
				</div>
				<p class="sec-head__lead reveal" style="--d: 0.2s">
					We respond <strong>personally</strong>: no automation, no sales pressure.
				</p>
			</header>

			<ul class="talk__grid">
				{
					contactCards.map(({ label, lines, href, external, icon }, i) => {
						const Tag = href ? 'a' : 'div';
						return (
							<li class="reveal" style={`--d: ${i * 0.08}s`}>
								<Tag
									class:list={['talk__item', href && 'talk__item--link']}
									href={href}
									target={external ? '_blank' : undefined}
									rel={external ? 'noopener' : undefined}
								>
									<span class="talk__label">
										<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
										{label}
									</span>
									<span class="talk__value">
										{lines.map((line, n) => (
											<>
												{n > 0 && <br />}
												{line}
											</>
										))}
									</span>
									{href && <svg class="talk__arrow" viewBox="0 0 24 24" aria-hidden="true" set:html={external ? externalIcon : arrow} />}
								</Tag>
							</li>
						);
					})
				}
			</ul>
		</div>
	</section>
</Layout>

<script>
	import { initShaders } from '../scripts/shader';

	initShaders();
</script>
