---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import '../styles/pages/contact.css';

import careersPhoto from '../assets/contact/careers.jpg';
import partnershipsPhoto from '../assets/contact/partnerships.jpg';

const arrow = '<path d="M5 12h14M12 5l7 7-7 7"/>';

/* ----- Flip cards ----- */

const flipCards = [
	{
		label: 'Careers',
		photo: careersPhoto,
		alt: 'Team collaborating around a laptop',
		front: ['Join the Vision.', 'Build the Future.'],
		title: 'Grow. Create. Lead.',
		text: 'Be part of a team that values ideas, energy, and the drive to make things happen.',
		href: 'https://sharktech.com.au/career',
	},
	{
		label: 'Partnerships',
		photo: partnershipsPhoto,
		alt: 'Business partners in a meeting',
		front: ['Partner With Us.', 'Achieve More.'],
		title: 'Unlock New Opportunities.',
		text: 'Join forces with us to leverage cutting-edge solutions and drive growth for both our businesses.',
		href: 'https://sharktech.com.au/partnerships-and-alliances',
	},
];

const formId = 'DiM1RLgmUaDmgQWSJZ6f';

/* ----- Reply note: little stack of message lines above the form ----- */

const replyLines = [72, 48, 60];
---

<Layout
	title="Contact Us | VCPility"
	description="Talk to VCPility. Send us a message and our team will get back to you within 24 hours."
>
	<!-- ============================================
	     Hero
	     ============================================ -->
	<section class="page-hero contact-hero">
		<div class="container">
			<p class="label reveal">
				<span class="bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
				Contact Us
			</p>

			<div class="page-hero__grid">
				<h1 class="page-hero__title reveal-lines">
					<span class="line"><span class="line__inner">Let’s Talk</span></span>
				</h1>

				<div>
					<p class="lead reveal" style="--d: 0.15s">
						Have a question or ready to transform your business? Fill out the form and our team will get
						back to you within 24 hours.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================
	     01 Form + flip cards
	     The header sits above the form only, so the cards line up with the top of the form panel.
	     ============================================ -->
	<section class="chapter contact">
		<div class="container contact__grid">
			<header class="contact__header">
				<p class="label reveal"><span class="label__num">01</span>Get in Touch</p>

				<h2 class="display contact__title reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">Send Us a Message</span></span>
				</h2>

				<p class="lead reveal" style="--d: 0.2s">
					We'd love to hear from you. Fill in the details below and we'll be in touch soon.
				</p>
			</header>

			<div class="contact__form reveal" style="--d: 0.25s">
				<!-- Decorative status strip: a message being written -->
				<div class="contact__status" aria-hidden="true" data-pause-offscreen>
					<span class="contact__dot"></span>
					<span class="contact__lines">
						{replyLines.map((w, k) => <span style={`--w: ${w}%; --k: ${k}`} />)}
					</span>
					<span class="contact__reply">Reply within 24 hours</span>
				</div>

				<!-- LeadConnector form: attributes are read by form_embed.js, which also auto-sizes the iframe -->
				<iframe
					src={`https://api.leadconnectorhq.com/widget/form/${formId}`}
					class="contact__iframe"
					id={`inline-${formId}`}
					title="Contact form"
					data-layout="{'id':'INLINE'}"
					data-trigger-type="alwaysShow"
					data-trigger-value=""
					data-activation-type="alwaysActivated"
					data-activation-value=""
					data-deactivation-type="neverDeactivate"
					data-deactivation-value=""
					data-form-name="Website Contact Us form latest"
					data-height="586"
					data-layout-iframe-id={`inline-${formId}`}
					data-form-id={formId}></iframe>
			</div>

			<ul class="contact__cards">
				{
					flipCards.map(({ label, photo, alt, front, title, text, href }, i) => (
						<li class="reveal" style={`--d: ${0.3 + i * 0.08}s`}>
							<div class="flip" tabindex="0" role="group" aria-label={label}>
								<div class="flip__inner">
									<div class="flip__front">
										<Image
											class="flip__photo"
											src={photo}
											alt={alt}
											widths={[400, 800]}
											sizes="(max-width: 1024px) 92vw, 380px"
										/>
										<span class="flip__tag" aria-hidden="true">{label}</span>
										<h3 class="flip__front-title">
											{front[0]} <span>{front[1]}</span>
										</h3>
									</div>
									<div class="flip__back">
										<p class="flip__back-title">{title}</p>
										<p class="flip__back-text">{text}</p>
										<a href={href} class="btn btn--light btn--compact flip__btn" target="_blank" rel="noopener">
											Learn More
											<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
										</a>
									</div>
								</div>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<script is:inline src="https://link.msgsndr.com/js/form_embed.js" async></script>
</Layout>
