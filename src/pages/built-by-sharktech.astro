---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import teamPhoto from '../assets/contact/careers.jpg';
import '../styles/pages/built-by-sharktech.css';

/* Swap in a real headshot when there is one - an empty string renders the
   initials instead of requesting a file that isn't there. */
const leaderPhoto = '';

/* ----- Hero fact file -----
   Every fact here is also stated elsewhere on the page. */

const facts = [
	{ label: 'Founded', value: '2024, Sydney NSW' },
	{ label: 'Headquarters', value: 'Liverpool, NSW' },
	{ label: 'Offices', value: 'Sydney · Melbourne' },
	{ label: 'Platforms', value: 'VCPility, AccrualOS, Flagman, Motivo360, eTakeaway Max' },
	{ label: 'Industries', value: 'Growth, accounting, industrial, wellness, hospitality' },
];

/* ----- Capability row (rendered twice so the velocity strip wraps seamlessly) ----- */

const marquee = [
	{ label: 'CRM & Pipeline', ai: false },
	{ label: 'Unified Inbox', ai: false },
	{ label: 'Automatic Bookings', ai: false },
	{ label: 'Reputation Management', ai: false },
	{ label: 'Recall Campaigns', ai: false },
	{ label: 'Landing Pages', ai: false },
	{ label: 'AI Chatbot', ai: true },
	{ label: 'AI Voice Assistant', ai: true },
	{ label: 'Built By Sharktech Global', ai: false },
];

/* ----- What it means for you ----- */

const points = [
	{
		title: 'Enterprise Engineering',
		icon: '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>',
		desc: "VCPility's architecture, AI agents and integrations are built by Sharktech's in-house technology team, led by its CTO. You're not on a reseller's white-label.",
	},
	{
		title: 'Shared AI Infrastructure',
		icon: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
		desc: 'Improvements made across the Sharktech portfolio, from voice AI to automation, flow into VCPility. Every product in the group makes the others stronger.',
	},
	{
		title: 'Australian Base',
		icon: '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>',
		desc: 'Headquartered in Sydney with an office in Melbourne. Support runs on AEST business hours and your data stays under an Australian company.',
	},
	{
		title: 'Long-Term Backing',
		icon: '<path d="M3 17l6-6 4 4 8-8"/><path d="M14 7h7v7"/>',
		desc: 'Sharktech Global is seed funded and in its scale year. VCPility has a roadmap and a team funded to deliver it.',
	},
];

const stats = [
	{ value: 50, suffix: '+', label: "Clients scaled with Sharktech's AI-first platforms" },
	{ value: 5, suffix: '', label: 'AI platforms in production or active development' },
	{ value: 4, suffix: '', label: 'Industry verticals served across the portfolio' },
];

/* ----- Portfolio ----- */

const vcpModules = [
	{ label: 'CRM & pipeline', ai: false },
	{ label: 'Unified inbox', ai: false },
	{ label: 'Bookings', ai: false },
	{ label: 'Reviews', ai: false },
	{ label: 'Campaigns', ai: false },
	{ label: 'Landing pages', ai: false },
	{ label: 'AI chatbot', ai: true },
	{ label: 'AI voice assistant', ai: true },
];

const siblings = [
	{
		name: 'AccrualOS',
		sector: 'Accounting',
		desc: 'Unifies accounting tools into one AI-powered ecosystem for practices.',
		icon: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>',
	},
	{
		name: 'Flagman',
		sector: 'Industrial',
		desc: 'Turns industrial signals into safety, process and quality intelligence.',
		icon: '<path d="M5 21V4M5 4h11l-2 4 2 4H5"/>',
	},
	{
		name: 'Motivo360',
		sector: 'Wellness',
		desc: 'Daily routines that adapt to you and build lasting consistency.',
		icon: '<path d="M20 12a8 8 0 1 1-2.3-5.6"/><path d="M20 4v4h-4"/>',
	},
	{
		name: 'eTakeaway Max',
		sector: 'Hospitality',
		desc: 'Online ordering platform for food businesses.',
		icon: '<path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
	},
];

/* ----- Journey ----- */

const timeline = [
	{
		when: '2024 Q1',
		title: 'Sharktech Global Founded',
		desc: 'Incorporated in Sydney, NSW with a vision for a multi-product AI platform group.',
		milestone: false,
	},
	{
		when: '2024 Q2',
		title: 'VCPility MVP Begins',
		desc: 'The architecture for an AI-powered growth and marketing platform is defined.',
		milestone: true,
	},
	{
		when: '2024 Q3',
		title: 'Portfolio Expansion',
		desc: 'eTakeaway Max and Flagman enter development and the multi-product strategy is formalised.',
		milestone: false,
	},
	{
		when: '2025 Q1',
		title: 'First Clients',
		desc: 'Initial clients onboarded on VCPility, with live revenue from day one.',
		milestone: true,
	},
	{
		when: '2025 Q3',
		title: 'AI Agents Go Live',
		desc: 'AI agent capabilities deployed across VCPility and automation goes live for clients.',
		milestone: true,
	},
	{
		when: '2026',
		title: 'Scale Year',
		desc: 'Five products live or in active build. Seed funded and going global.',
		milestone: false,
	},
];

/* ----- FAQ ----- */

const faqs = [
	{
		q: 'Is VCPility owned by Sharktech Global?',
		a: 'Yes. VCPility is one of five AI platforms built and operated by Sharktech Global, an Australian AI platform group headquartered in Sydney.',
	},
	{
		q: 'Who do I contact for support?',
		a: "The VCPility team handles onboarding and day-to-day support, backed by Sharktech's engineering team for anything technical. Support runs Monday to Friday, 9 AM to 6 PM AEST.",
	},
	{
		q: 'Does being part of a group change my pricing or contract?',
		a: 'No. You sign up for and pay for VCPility directly. Sharktech provides the technology and backing behind it.',
	},
	{
		q: 'Can VCPility work with other Sharktech products?',
		a: 'Yes. Products in the portfolio share AI infrastructure, so businesses that use more than one, like accounting practices on AccrualOS, get a connected setup.',
	},
];

const offices = [
	{ label: 'Sydney (Headquarters)', detail: 'Level 1, 244 Macquarie St, Liverpool NSW 2170' },
	{ label: 'Melbourne', detail: 'Suite 383, 11 Wilson St, South Yarra VIC 3141' },
	{ label: 'Hours', detail: 'Mon–Fri, 9 AM – 6 PM AEST' },
];

const icons = {
	arrow: '<path d="M5 12h14M12 5l7 7-7 7"/>',
	external: '<path d="M7 17 17 7M8 7h9v9"/>',
	down: '<path d="M12 5v14M5 12l7 7 7-7"/>',
};

const pad = (n: number) => String(n).padStart(2, '0');

// The logo's five colour bars, used as small accents (index 0-4 maps to --brand-1 … --brand-5)
const brand = (i: number) => `var(--brand-${(i % 5) + 1})`;

const sparkle = '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/>';
---

<Layout
	title="Built by Sharktech Global | VCPility"
	description="VCPility is the growth platform inside Sharktech Global, a Sydney-based AI platform group. The same team engineers, hosts and supports your CRM, inbox, bookings and AI agents."
	keywords="Sharktech Global, VCPility parent company, Australian AI platform group, Sydney AI company"
>
	<!-- ============================================
	     Hero: headline and lead, then the group's fact file
	     ============================================ -->
	<section class="page-hero vst-hero">
		<div class="container">
			<p class="label reveal">
				<span class="bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
				Our parent company
			</p>

			<div class="page-hero__grid">
				<h1 class="page-hero__title reveal-lines">
					<span class="line"><span class="line__inner">Serious Engineering</span></span>
					<span class="line" style="--i: 1"><span class="line__inner muted">Behind Every Enquiry</span></span>
				</h1>

				<div>
					<p class="lead reveal" style="--d: 0.15s">
						VCPility is the growth platform inside Sharktech Global, a Sydney-based AI platform group. That means the CRM,
						inbox, bookings and AI agents you use are engineered, hosted and supported by the same team building five AI
						products across four industries.
					</p>

					<div class="page-hero__buttons reveal" style="--d: 0.25s">
						<a
							class="btn btn--accent btn--shine"
							href="https://sharktech.com.au/vcpility"
							target="_blank"
							rel="noopener"
							data-magnetic
						>
							See VCPility on Sharktech
							<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.external} />
						</a>
						<a class="btn btn--link vst-btn-down" href="#vst-faq">
							How the relationship works
							<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.down} />
						</a>
					</div>

					<div class="vst-leader reveal" style="--d: 0.35s">
						<div class="vst-leader__ava">
							{
								leaderPhoto ? (
									<img src={leaderPhoto} alt="Dainu Devis" width="56" height="56" loading="lazy" />
								) : (
									<span aria-hidden="true">DD</span>
								)
							}
						</div>
						<p>
							<b>Led by Dainu Devis,</b> CEO of Sharktech Global. VCPility is built and run by the same leadership team
							behind every platform in the group.
						</p>
					</div>
				</div>
			</div>

			<aside class="vst-file reveal" style="--d: 0.2s" aria-labelledby="vst-file-title">
				<header class="vst-file__head">
					<span>Fact file</span>
					<h2 id="vst-file-title">Sharktech Global</h2>
				</header>
				<dl class="vst-file__facts">
					{
						facts.map(({ label, value }, i) => (
							<div style={`--c: ${brand(i)}`}>
								<dt>{label}</dt>
								<dd>{value}</dd>
							</div>
						))
					}
				</dl>
				<div class="vst-file__here">
					<span class="vst-here">You're here</span>
					<p><b>VCPility</b>, the group's growth platform. Live with clients since 2025.</p>
				</div>
			</aside>
		</div>
	</section>

	<!-- ----- Capabilities: a row that speeds up and flips with scrolling (Scroll Based Velocity).
	     Rendered twice so it can wrap seamlessly. ----- -->
	<div class="vst-velocity" aria-hidden="true" data-velocity="1">
		<div class="vst-velocity__track">
			{
				[0, 1].map(() =>
					marquee.map(({ label, ai }, i) => (
						<span class="vst-velocity__item">
							{ai && <svg viewBox="0 0 24 24" set:html={sparkle} />}
							{label}
							<span class="vst-velocity__dot" style={`background: ${brand(i)}`} />
						</span>
					)),
				)
			}
		</div>
	</div>

	<!-- ============================================
	     01 What it means for you
	     ============================================ -->
	<section class="chapter vst-means">
		<div class="container vst-means__layout">
			<div class="vst-means__head">
				<p class="label reveal"><span class="label__num">01</span>What it means for you</p>
				<h2 class="display reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">A Product Team Behind</span></span>
					<span class="line" style="--i: 1"><span class="line__inner muted">Your Growth Engine</span></span>
				</h2>
				<figure class="vst-means__img reveal" style="--d: 0.2s">
					<div class="vst-means__frame">
						<Image
							src={teamPhoto}
							alt="The Sharktech Global team building VCPility"
							width={960}
							widths={[480, 960]}
							sizes="(max-width: 1024px) 90vw, 45vw"
						/>
					</div>
					<figcaption><span class="vst-means__tag">Sydney</span> Engineered by Sharktech Global</figcaption>
				</figure>
			</div>

			<ol class="vst-points">
				{
					points.map(({ title, desc, icon }, i) => (
						<li class="vst-point reveal" style={`--d: ${i * 0.08}s`}>
							<div class="vst-point__head">
								<span class="vst-point__num">{pad(i + 1)}</span>
								<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} data-draw />
							</div>
							<h3>{title}</h3>
							<p>{desc}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ============================================
	     Stats band: rolling digits (Number Ticker)
	     ============================================ -->
	<section class="vst-band">
		<div class="container">
			<dl class="vst-band__grid">
				{
					stats.map(({ value, suffix, label }, i) => (
						<div class="vst-band__item reveal" style={`--d: ${i * 0.08}s; --c: ${brand(i * 2)}`}>
							<dt>{label}</dt>
							<dd class="ticker" data-ticker data-reveal style={`--d: ${i * 0.12}s`}>
								{value}
								{suffix}
							</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- ============================================
	     02 Portfolio: VCPility as the lead card, its siblings beside it
	     ============================================ -->
	<section class="chapter vst-port">
		<div class="container">
			<p class="label reveal"><span class="label__num">02</span>The Sharktech portfolio</p>

			<div class="chapter__head">
				<h2 class="display reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">Where VCPility Fits</span></span>
				</h2>
				<p class="lead reveal" style="--d: 0.25s">
					Five AI platforms, one engineering team. VCPility handles growth; its siblings cover accounting, industry,
					wellness and hospitality.
				</p>
			</div>

			<div class="vst-port__grid" data-pause-offscreen>
				<div class="vst-port__feat reveal">
					<article class="card" data-spotlight>
						<span class="beam" aria-hidden="true"></span>
						<div class="vst-feat__top">
							<span class="vst-here">You're here</span>
							<span class="vst-feat__live">Live with clients since 2025</span>
						</div>
						<h3>VCPility</h3>
						<p>The growth engine of the group. Every enquiry answered, booked and followed up from one platform.</p>
						<ul class="vst-feat__mods">
							{
								vcpModules.map(({ label, ai }, i) => (
									<li class:list={[ai && 'is-ai']} style={`--k: ${i}`}>
										{ai && <svg viewBox="0 0 24 24" aria-hidden="true" set:html={sparkle} />}
										{label}
									</li>
								))
							}
						</ul>
						<div class="vst-feat__foot">
							<span>Growth &amp; marketing</span>
							<span>Flagship platform</span>
						</div>
					</article>
				</div>

				{
					siblings.map(({ name, sector, desc, icon }, i) => (
						<div class="vst-port__sib reveal" style={`--d: ${(i + 1) * 0.06}s`}>
							<article class="card" data-spotlight>
								<div class="vst-sib__top">
									<span class="vst-sib__ico" style={`--c: ${brand(i)}`}>
										<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} data-draw />
									</span>
									<small>{sector}</small>
								</div>
								<h3>{name}</h3>
								<p>{desc}</p>
							</article>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- ============================================
	     03 Journey: a Tracing Beam lights each step as you read, on a Flickering Grid
	     ============================================ -->
	<section class="chapter chapter--ink vst-journey" data-pause-offscreen>
		<canvas class="vst-journey__grid" aria-hidden="true" data-flicker-grid data-flicker-color="255, 255, 255"></canvas>

		<div class="container">
			<p class="label reveal"><span class="label__num">03</span>Our journey together</p>

			<h2 class="display reveal-lines" style="--d: 0.1s">
				<span class="line"><span class="line__inner">From One Idea To A</span></span>
				<span class="line" style="--i: 1"><span class="line__inner muted">Platform Group</span></span>
			</h2>

			<ol class="vst-tl" data-trace>
				<li class="vst-tl__beam" aria-hidden="true"><span></span></li>
				{
					timeline.map(({ when, title, desc, milestone }) => (
						<li class="vst-tl__step" data-trace-step>
							<time>{when}</time>
							<div class="vst-tl__body">
								<h3>
									{title}
									{milestone && <span class="vst-tl__tag">VCPility milestone</span>}
								</h3>
								<p>{desc}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ============================================
	     04 FAQ
	     ============================================ -->
	<section class="chapter vst-faq" id="vst-faq">
		<div class="container vst-faq__layout">
			<header class="vst-faq__head">
				<p class="label reveal"><span class="label__num">04</span>FAQ</p>
				<h2 class="display reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">About VCPility</span></span>
					<span class="line" style="--i: 1"><span class="line__inner muted">And Sharktech</span></span>
				</h2>
			</header>

			<div class="vst-faq__list reveal" style="--d: 0.15s">
				{
					faqs.map(({ q, a }, i) => (
						<details open={i === 0}>
							<summary>
								<span class="vst-faq__num">{pad(i + 1)}</span>
								{q}
							</summary>
							<p>{a}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<!-- ============================================
	     Closing CTA: shader panel with Ripple rings, offices beneath
	     ============================================ -->
	<section class="finale vst-finale">
		<div class="container">
			<div class="finale__panel" data-pause-offscreen>
				<canvas class="shader" aria-hidden="true" data-shader></canvas>
				<span class="ripple" aria-hidden="true">
					{[0, 1, 2, 3, 4].map((n) => <span style={`--n: ${n}`} />)}
				</span>

				<div class="finale__inner">
					<span class="bars bars--light reveal" aria-hidden="true"
						><span></span><span></span><span></span><span></span><span></span></span
					>
					<p class="vst-finale__label reveal">Connect with us</p>
					<h2 class="finale__title reveal-lines" style="--d: 0.1s">
						<span class="line"><span class="line__inner">Grow With VCPility,</span></span>
						<span class="line" style="--i: 1"><span class="line__inner">Backed By Sharktech</span></span>
					</h2>
					<p class="finale__text reveal" style="--d: 0.3s">
						One platform to manage leads, bookings, reviews and campaigns, so every enquiry gets an instant response.
					</p>
					<div class="finale__buttons reveal" style="--d: 0.4s">
						<a class="btn btn--light btn--shine" href="/contact" data-magnetic>
							Book a VCPility demo
							<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.arrow} />
						</a>
						<a class="btn btn--link btn--on-ink" href="https://sharktech.com.au" target="_blank" rel="noopener">
							Visit Sharktech Global
							<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.external} />
						</a>
					</div>
				</div>
			</div>

			<dl class="vst-offices">
				{
					offices.map(({ label, detail }, i) => (
						<div class="reveal" style={`--d: ${i * 0.08}s`}>
							<dt>{label}</dt>
							<dd>{detail}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>
</Layout>
