// The calendar mockup shows the month the site was built in, with weekdays in the right columns.
// Booked days sit around "today", including tomorrow to match the floating confirmation card.
const now = new Date();
const calYear = now.getFullYear();
const calMonth = now.getMonth();
const calToday = now.getDate();
const calLabel = now.toLocaleString('en-AU', { month: 'long', year: 'numeric' });
const firstWeekday = new Date(calYear, calMonth, 1).getDay();
const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
const daysInPrevMonth = new Date(calYear, calMonth, 0).getDate();
const bookedDays = new Set([-14, -12, -8, -6, 1, 3, 6, 11].map((offset) => calToday + offset));

type CalendarDay = { day: number; outside?: boolean; today?: boolean; booked?: boolean };

const calendarDays: CalendarDay[] = [
	...Array.from({ length: firstWeekday }, (_, i) => ({
		day: daysInPrevMonth - firstWeekday + i + 1,
		outside: true,
	})),
	...Array.from({ length: daysInMonth }, (_, i) => ({
		day: i + 1,
		today: i + 1 === calToday,
		booked: bookedDays.has(i + 1),
	})),
];
// Finish the last week with the start of next month
const trailing = (7 - (calendarDays.length % 7)) % 7;
calendarDays.push(...Array.from({ length: trailing }, (_, i) => ({ day: i + 1, outside: true })));

const weekdays = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

