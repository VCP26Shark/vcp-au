<Layout
	title="Features | VCPility"
	description="20+ business management tools in one platform: CRM, AI chatbot, smart booking, AI voice and more."
>
	<!-- ============================================
	     Hero
	     ============================================ -->
	<section class="feat-hero">
		<div class="feat-hero__container">
			<header class="feat-hero__header">
				<div class="feat-hero__intro">
					<p class="eyebrow feat-hero__eyebrow">Platform Features</p>

					<h1 class="section-title section-title--sm feat-hero__title">
						<span class="line" style="--i: 0"><span class="line__inner">Everything You Need,</span></span>
						<span class="line" style="--i: 1">
							<span class="line__inner"><span class="mark">One Platform</span></span>
						</span>
					</h1>

					<p class="feat-hero__lead">
						All your business management tools in one easy-to-use platform built for busy
						professionals.
					</p>
				</div>

				<p class="feat-hero__stat">
					<span class="feat-hero__stat-num mark" data-count="20" data-suffix="+" data-count-delay="600">
						20+
					</span>
					<span class="feat-hero__stat-text">
						<strong>Business<br />Management Tools</strong>
						<span>One subscription</span>
					</span>
				</p>
			</header>

			<ul class="bento">
				{
					heroTiles.map(({ size, variant, label, title, href, desc, list, icon }, i) => (
						<li class={`bento__item bento__item--${size}`} style={`--i: ${i}`}>
							<a href={href} class:list={['tile', variant && `tile--${variant}`]}>
								<span class="tile__icon">
									<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
								</span>
