										<svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg>
									</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<script>
		/* Unified platform: zoom the 1100px-wide mockup down to fit narrower screens.
		   zoom (unlike transform: scale) shrinks the layout box too, so no height hacks are needed. */
		const stage = document.querySelector<HTMLElement>('[data-platform-stage]');
		const platform = stage?.querySelector<HTMLElement>('[data-platform]');

		if (stage && platform) {
			const DESIGN_WIDTH = 1100;
			const fit = () => {
				const scale = Math.min(1, stage.clientWidth / DESIGN_WIDTH);
				platform.style.zoom = scale < 1 ? String(scale) : '';
			};
			new ResizeObserver(fit).observe(stage);
		}
	</script>

