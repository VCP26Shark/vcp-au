										<strong>{calLabel}</strong>
										<span class="platform__cal-nav">
											<span><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg></span>
											<span><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
										</span>
									</div>
									<div class="platform__cal-grid">
										{['S', 'M', 'T', 'W', 'T', 'F', 'S'].map((d) => <span class="platform__cal-weekday">{d}</span>)}
										{
											miniDays.map(({ day, today, booked, outside }) => (
												<span
													class:list={[
														'platform__cal-day',
														{
															'platform__cal-day--today': today,
															'platform__cal-day--booked': booked,
															'platform__cal-day--outside': outside,
														},
													]}
												>
													{day}
												</span>
											))
										}
									</div>
								</div>
							</div>

							<div class="platform__panel-block">
								<p class="platform__panel-title">Upcoming Tasks</p>
								{
									platformTasks.map(({ text, due, done }) => (
										<div class="platform__task">
											<span class:list={['platform__check', { 'platform__check--done': done }]} />
											<span>
												<span class="platform__task-text">{text}</span>
												<span class="platform__task-due">{due}</span>
											</span>
										</div>
