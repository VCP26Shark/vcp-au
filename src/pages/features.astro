		label: 'Core Feature',
		title: ['Automated Thank You', '& Review Requests'],
		desc: 'Turn every customer interaction into an opportunity to build your reputation. Our automated system sends personalised thank you messages and review requests at the perfect moment - helping you collect more 5-star reviews without lifting a finger.',
		points: [
			{ title: 'Perfect Timing', desc: 'Messages sent automatically after appointments or purchases' },
			{ title: 'Multi-Channel Delivery', desc: 'Reach customers via SMS, email, or WhatsApp' },
			{ title: 'Review Routing', desc: 'Direct happy customers to Google, Facebook, or your preferred platform' },
		],
		art: 'review',
		toasts: [{ title: '+47% More Reviews', text: 'Average increase', icon: icons.star }],
	},
	{
		id: 'recall-retention',
		label: 'Core Feature',
		title: ['Customer Recall', '& Retention Campaigns'],
		desc: 'Stop losing customers to inactivity. Our intelligent retention system identifies at-risk customers before they leave and automatically sends personalised win-back campaigns - turning dormant contacts into loyal, returning customers.',
		points: [
			{ title: 'Smart Segmentation', desc: 'Automatically identify inactive and at-risk customers' },
			{ title: 'Personalised Outreach', desc: 'Tailored messages with special offers to win them back' },
			{ title: 'Automated Sequences', desc: 'Multi-step campaigns that nurture customers back to you' },
		],
		art: 'retain',
		toasts: [
			{
				title: 'Customer Reactivated',
				text: 'Win-back successful',
				icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/>',
			},
		],
		flip: true,
	},
];

/* ----- Closing CTA ----- */

const ctaStats = [
	{ value: 20, suffix: '+', label: 'Business Tools' },
	{ value: 70, suffix: '%', label: 'Cost Savings' },
	{ text: '24/7', label: 'AI Automation' },
	{ value: 1, suffix: '', label: 'Subscription' },
];

const ctaTrust = [
	{ label: 'Secure & Encrypted', icon: icons.shield },
	{ label: 'No Lock-in Contracts', icon: checkCircle },
	{ label: 'Dedicated Support', icon: icons.users },
];
---

<Layout
	title="Features | VCPility"
	description="20+ business management tools in one platform: CRM, AI chatbot, smart booking, AI voice and more."
>
	<!-- ============================================
	     Hero: two-tone title, the tool count, and a bento of the core features
	     ============================================ -->
	<section class="page-hero feat-hero">
		<div class="container">
			<p class="label reveal">
				<span class="bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
				Platform Features
			</p>

			<div class="page-hero__grid">
				<h1 class="page-hero__title reveal-lines">
					<span class="line"><span class="line__inner">Everything You Need,</span></span>
					<span class="line" style="--i: 1"><span class="line__inner muted">One Platform</span></span>
				</h1>

				<div>
					<p class="lead reveal" style="--d: 0.15s">
						All your business management tools in one easy-to-use platform built for busy professionals.
					</p>
					<p class="feat-hero__stat reveal" style="--d: 0.25s">
						<span class="feat-hero__num ticker" data-ticker data-reveal style="--d: 0.3s">20+</span>
						<span class="feat-hero__stat-text">
							<strong>Business Management Tools</strong>
							<span>One subscription</span>
						</span>
					</p>
				</div>
			</div>

			<ul class="feat-bento" data-pause-offscreen>
				{
					heroTiles.map(({ size, art, label, title, href, desc, list, icon }, i) => (
						<li class={`feat-bento__item feat-bento__item--${size} feat-bento__item--${art} reveal`} style={`--d: ${i * 0.06}s`}>
							<a href={href} class="card feat-tile" data-spotlight>
								<span class="feat-tile__num" aria-hidden="true">
									{pad(i + 1)}
								</span>

								<span class="feat-tile__art" aria-hidden="true">
									{art === 'kanban' && (
										<span class="ta-kanban">
											{kanbanCols.map(({ stage, cards }, c) => (
												<span class="ta-kanban__col">
													<span class="ta-kanban__stage" style={`--c: ${brand(c)}`}>
														{stage}
													</span>
													{Array.from({ length: cards }, (_, k) => (
														<span class="ta-kanban__card" style={`--k: ${c + k}`}>
															<span />
															<span />
														</span>
													))}
												</span>
											))}
											<span class="ta-kanban__mover">
												<span />
												<span />
											</span>
										</span>
									)}

									{art === 'chat' && (
										<span class="ta-chat">
											{tileChat.map(({ from, text }, k) => (
												<span class={`ta-chat__msg ta-chat__msg--${from}`} style={`--k: ${k}`}>
													{text}
												</span>
											))}
											<span class="ta-chat__typing" style="--k: 3">
												<span />
												<span />
												<span />
											</span>
										</span>
									)}

									{art === 'calendar' && (
										<span class="ta-cal">
											{Array.from({ length: 35 }, (_, d) => (
												<span
													class:list={['ta-cal__day', tileBooked.includes(d) && 'is-booked', d === tileToday && 'is-today']}
													style={`--k: ${Math.max(tileBooked.indexOf(d), 0)}`}
												/>
											))}
										</span>
									)}

									{art === 'wave' && (
										<span class="ta-wave">
											<span class="ta-wave__call">
												<svg viewBox="0 0 24 24" set:html={icons.phone} />
											</span>
											<span class="ta-wave__bars">
												{waveBars.map((h, k) => (
													<span style={`--h: ${h}%; --k: ${k}`} />
												))}
											</span>
										</span>
									)}

									{art === 'chart' && (
										<span class="ta-chart">
											{tileBars.map((h, k) => (
												<span class="ta-chart__bar" style={`--h: ${h}%; --k: ${k}`} />
											))}
											<svg class="ta-chart__line" viewBox="0 0 100 40" preserveAspectRatio="none">
												<path d="M0 34 L14 28 L28 31 L42 20 L57 23 L71 12 L85 15 L100 4" pathLength="1" />
											</svg>
										</span>
									)}
								</span>

								<span class="feat-tile__body">
									<span class="feat-tile__label">
										<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
										{label}
									</span>
									<h2 class="feat-tile__title">{title}</h2>
									<p class="feat-tile__desc">{desc}</p>
									{list && (
										<ul class="feat-tile__list">
											{list.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									)}
									<span class="feat-tile__more">
										Learn more
										<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
									</span>
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ============================================
	     01 Tools: two rows of tools that drift, faster as you scroll (Scroll Based Velocity)
	     ============================================ -->
	<section class="chapter feat-tools">
		<div class="container">
			<p class="label reveal"><span class="label__num">01</span>All-in-One Platform</p>

			<h2 class="display reveal-lines" style="--d: 0.1s">
				<span class="line"><span class="line__inner">20+ Business Tools,</span></span>
				<span class="line" style="--i: 1"><span class="line__inner muted">One Subscription</span></span>
			</h2>
		</div>

		<div class="feat-tools__rows reveal" style="--d: 0.2s">
			{
				toolRows.map((set, r) => (
					<div class="feat-tools__row" data-velocity={r ? '-1' : '1'}>
						<div class="feat-tools__track">
							{/* Each row is drawn twice so it wraps seamlessly; the copy is hidden from screen readers */}
							{[false, true].map((isCopy) => (
								<ul class="feat-tools__set" aria-hidden={isCopy ? 'true' : undefined}>
									{set.map(({ label, icon }) => (
										<li class="feat-tool">
											<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
											{label}
										</li>
									))}
								</ul>
							))}
						</div>
					</div>
				))
			}
		</div>

		<div class="container">
			<dl class="feat-band">
				{
					toolStats.map(({ value, suffix, label }, i) => (
						<div class="feat-band__item reveal" style={`--d: ${i * 0.08}s; --c: ${brand(i)}`}>
							<dt>{label}</dt>
							<dd class="ticker" data-ticker data-reveal style={`--d: ${i * 0.12}s`}>
								{value}
								{suffix}
							</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- ============================================
	     02-10 Feature chapters: copy and checklist beside a live product mock
	     ============================================ -->
	{
		rows.map(({ id, label, title, desc, points, art, toasts, flip, stack }, i) => (
			<section
				class:list={[
					'chapter',
					'feat-row',
					`feat-row--${art}`,
					{ 'feat-row--flip': flip, 'feat-row--stack': stack, 'chapter--ink': stack },
				]}
				id={id}
				data-pause-offscreen
			>
				<div class="container feat-row__grid">
					<div class="feat-row__copy">
						<p class="label reveal">
							<span class="label__num">{pad(i + 2)}</span>
							{label}
						</p>

						<h2 class="display feat-row__title reveal-lines" style="--d: 0.1s">
							<span class="line">
								<span class="line__inner">{title[0]}</span>
							</span>
							<span class="line" style="--i: 1">
								<span class="line__inner muted">{title[1]}</span>
							</span>
						</h2>

						<p class="lead reveal" style="--d: 0.2s">
							{desc}
						</p>

						{points && (
							<ul class="feat-points">
								{points.map(({ title: point, desc: detail }, k) => (
									<li class="feat-points__item reveal" style={`--d: ${0.2 + k * 0.06}s`}>
										<span class="feat-points__icon">
											<svg viewBox="0 0 24 24" aria-hidden="true" set:html={check} data-draw />
										</span>
										<span>
											<strong>{point}</strong>
											<span>{detail}</span>
										</span>
									</li>
								))}
							</ul>
						)}
					</div>

					<div class="feat-row__visual reveal" style="--d: 0.1s" aria-hidden="true" data-platform-stage={stack ? '' : undefined}>
						{toasts.map(({ title: toast, text, icon }, k) => (
							<span class={`feat-toast feat-toast--${k ? 'end' : 'start'}`} style={`--c: ${brand((i + k) % 4)}`}>
								<span class="feat-toast__icon">
									<svg viewBox="0 0 24 24" set:html={icon} />
								</span>
								<span class="feat-toast__text">
									<strong>{toast}</strong>
									<span>{text}</span>
								</span>
							</span>
						))}

						{/* ----- Smart booking: month calendar and today's slots ----- */}
						{art === 'calendar' && (
							<div class="feat-mock calendar">
								<div class="calendar__header">
									<span class="calendar__month">{calLabel}</span>
									<span class="mock-nav">
										<span>
											<svg viewBox="0 0 24 24" set:html={icons.prev} />
										</span>
										<span>
											<svg viewBox="0 0 24 24" set:html={icons.next} />
										</span>
									</span>
								</div>

								<div class="calendar__grid">
									{weekdays.map((d) => (
										<span class="calendar__weekday">{d}</span>
									))}
									{calendarDays.map(({ day, outside, today, booked }, k) => (
										<span
											class:list={[
												'calendar__day',
												{
													'calendar__day--outside': outside,
													'calendar__day--today': today,
													'calendar__day--booked': booked,
												},
											]}
											style={`--k: ${k}`}
										>
											{day}
										</span>
									))}
								</div>

								<div class="calendar__slots">
									<p class="mock-title">Today's Appointments</p>
									{bookingSlots.map(({ time, name, service }, k) => (
										<div class="calendar__slot" style={`--k: ${k}`}>
											<span class="calendar__time">{time}</span>
											<span class="mock-who">
												<strong>{name}</strong>
												<span>{service}</span>
											</span>
											<span class="mock-pill mock-pill--ok">Confirmed</span>
										</div>
									))}
								</div>
							</div>
						)}

						{/* ----- Mobile app: a phone with today's numbers ----- */}
						{art === 'phone' && (
							<div class="app-phone">
								<div class="app-phone__screen">
									<div class="app-phone__status">
										<span>9:41</span>
										<span class="app-phone__island" />
										<span class="app-phone__icons">
											<svg viewBox="0 0 24 24">
												<path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01" />
											</svg>
											<span class="app-phone__battery" />
										</span>
									</div>

									<div class="app-phone__header">
										<span>Good morning</span>
										<strong>Sarah 👋</strong>
									</div>

									<div class="app-phone__stats">
										{appStats.map(({ value, label: stat }, k) => (
											<span class="app-phone__stat" style={`--c: ${brand(k)}`}>
												<strong>{value}</strong>
												<span>{stat}</span>
											</span>
										))}
									</div>

									<div class="app-phone__content">
										<p class="mock-title">Upcoming Today</p>
										{appAppointments.map(({ initials, name, time, length }, k) => (
											<div class="app-phone__appt" style={`--k: ${k}`}>
												<span class="mock-avatar">{initials}</span>
												<span class="mock-who">
													<strong>{name}</strong>
													<span>{time}</span>
												</span>
												<span class="mock-pill">{length}</span>
											</div>
										))}
									</div>

									<span class="app-phone__home" />
								</div>
							</div>
						)}

						{/* ----- AI chatbot: the conversation writes itself in on reveal ----- */}
						{art === 'chat' && (
							<div class="feat-mock chat">
								<div class="chat__header">
									<span class="chat__avatar">
										<svg viewBox="0 0 24 24" set:html={robot} />
									</span>
									<span class="mock-who">
										<strong>VCPility AI Assistant</strong>
										<span class="chat__status">Online</span>
									</span>
								</div>

								<div class="chat__messages">
									{chatMessages.map(({ from, text, time }, k) => (
										<div class={`chat__msg chat__msg--${from}`} style={`--k: ${k}`}>
											<p class="chat__bubble">{text}</p>
											<span class="chat__time">{time}</span>
										</div>
									))}
									<div class="chat__typing" style={`--k: ${chatMessages.length}`}>
										<span />
										<span />
										<span />
									</div>
								</div>

								<div class="chat__input">
									<span>Type a message...</span>
									<span class="chat__send">
										<svg viewBox="0 0 24 24" set:html={send} />
									</span>
								</div>
							</div>
						)}

						{/* ----- CRM: a sales pipeline board ----- */}
						{art === 'crm' && (
							<div class="feat-mock crm">
								<div class="crm__header">
									<span class="mock-heading">Sales Pipeline</span>
									<span class="crm__search">
										<svg viewBox="0 0 24 24">
											<circle cx="11" cy="11" r="8" />
											<path d="m21 21-4.35-4.35" />
										</svg>
										Search contacts...
									</span>
								</div>

								<div class="crm__pipeline">
									{pipeline.map(({ stage, count, deals }, c) => (
										<div class="crm__column">
											<div class="crm__column-head" style={`--c: ${brand(c)}`}>
												<span>{stage}</span>
												<span class="crm__count">{count}</span>
											</div>
											{deals.map(({ name, email, value }, k) => (
												<div class="crm__deal" style={`--k: ${c + k}`}>
													<strong>{name}</strong>
													<span>{email}</span>
													<em>{value}</em>
												</div>
											))}
										</div>
									))}
								</div>
							</div>
						)}

						{/* ----- Analytics: stat tiles and a trend chart that draws in ----- */}
						{art === 'dash' && (
							<div class="feat-mock dash">
								<div class="dash__header">
									<span class="mock-heading">Business Overview</span>
									<span class="mock-pill">
										<svg viewBox="0 0 24 24" set:html={icons.calendar} />
										Last 30 Days
									</span>
								</div>

								<div class="dash__stats">
									{dashStats.map(({ label: stat, value, prefix = '', suffix = '', decimals = 0, change, down }, k) => (
										<div class="dash__stat">
											<strong class="ticker" data-ticker data-reveal style={`--d: ${0.2 + k * 0.08}s`}>
												{prefix}
												{value.toFixed(decimals)}
												{suffix}
											</strong>
											<span class="dash__label">{stat}</span>
											<span class:list={['dash__change', { 'dash__change--down': down }]}>
												<svg viewBox="0 0 24 24">
													<polyline points={down ? '6 9 12 15 18 9' : '18 15 12 9 6 15'} />
												</svg>
												{change}
											</span>
										</div>
									))}
								</div>

								<div class="dash__chart-area">
									<div class="dash__chart-head">
										<span class="mock-title">Revenue & Leads Trend</span>
										<span class="dash__legend">
											<span class="dash__key dash__key--revenue">Revenue</span>
											<span class="dash__key dash__key--leads">Leads</span>
										</span>
									</div>

									<svg class="dash__chart" viewBox="0 0 400 120" preserveAspectRatio="none">
										{[30, 60, 90].map((y) => (
											<line class="dash__grid" x1="0" y1={y} x2="400" y2={y} />
										))}
										<path class="dash__fill" d={`${revenueLine} L400,100 L0,100 Z`} />
										<path class="dash__line dash__line--revenue" d={revenueLine} pathLength="1" />
										<path class="dash__line dash__line--leads" d={leadsLine} pathLength="1" />
									</svg>

									<div class="dash__weeks">
										{['Week 1', 'Week 2', 'Week 3', 'Week 4'].map((w) => (
											<span>{w}</span>
										))}
									</div>
								</div>
							</div>
						)}

						{/* ----- Unified platform: the whole app, laid out at 1100px and zoomed to fit (script below) ----- */}
						{art === 'platform' && (
							<div class="feat-mock platform" data-platform>
								<div class="browser">
									<span class="browser__dots">
										<span />
										<span />
										<span />
									</span>
									<span class="browser__url">
										<svg viewBox="0 0 24 24" set:html={icons.lock} />
										app.vcpility.com/dashboard
									</span>
								</div>

								<div class="platform__layout">
									<div class="platform__sidebar">
										<div class="platform__brand">
											<span class="bars">
												<span />
												<span />
												<span />
												<span />
												<span />
											</span>
											VCPility
										</div>
										{platformNav.map(({ label: nav, icon, active }) => (
											<span class:list={['platform__nav', { 'platform__nav--active': active }]}>
												<svg viewBox="0 0 24 24" set:html={icon} />
												{nav}
											</span>
										))}
									</div>

									<div class="platform__main">
										<div class="platform__main-head">
											<span class="platform__greeting">Good morning, Sarah 👋</span>
											<span class="platform__actions">
												<span class="mock-btn">Export</span>
												<span class="mock-btn mock-btn--primary">+ New Lead</span>
											</span>
										</div>

										<div class="platform__stats">
											{platformStats.map(({ label: stat, value, change, icon }, k) => (
												<div class="platform__stat" style={`--c: ${brand(k)}`}>
													<span class="platform__stat-head">
														<span class="mock-icon">
															<svg viewBox="0 0 24 24" set:html={icon} />
														</span>
														<span class="dash__change">
															<svg viewBox="0 0 24 24">
																<polyline points="18 15 12 9 6 15" />
															</svg>
															{change}
														</span>
													</span>
													<strong>{value}</strong>
													<span class="dash__label">{stat}</span>
												</div>
											))}
										</div>

										<div class="platform__activity">
											<div class="platform__activity-head">
												<strong>Recent Activity</strong>
												<span>View All</span>
											</div>
											{platformActivity.map(({ title: event, text, time, icon }, k) => (
												<div class="platform__event" style={`--k: ${k}; --c: ${brand(k)}`}>
													<span class="mock-icon">
														<svg viewBox="0 0 24 24" set:html={icon} />
													</span>
													<span class="mock-who">
														<span class="platform__event-text">
															<strong>{event}</strong> {text}
														</span>
														<span>{time}</span>
													</span>
												</div>
											))}
										</div>
									</div>

									<div class="platform__panel">
										<div class="platform__block">
											<p class="mock-title">Calendar</p>
											<div class="platform__cal">
												<div class="platform__cal-head">
													<strong>{calLabel}</strong>
													<span class="mock-nav">
														<span>
															<svg viewBox="0 0 24 24" set:html={icons.prev} />
														</span>
														<span>
															<svg viewBox="0 0 24 24" set:html={icons.next} />
														</span>
