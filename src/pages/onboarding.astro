---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/onboarding.css';

const pad = (n: number) => String(n).padStart(2, '0');

// The logo's five colour bars, used as small accents (index 0-4 maps to --brand-1 … --brand-5)
const brand = (i: number) => `var(--brand-${(i % 5) + 1})`;

const steps = ['Fill the form', 'We build your system', 'You grow'];
const formId = '2FSuzzr2EK0YWz3PCz3A';
---

<Layout
	title="Onboarding | VCPility"
	description="Welcome aboard. Share a few details and we'll start building your AI-powered system."
	noindex
>
	<!-- ============================================
	     Hero: title left, lead and the three steps right
	     ============================================ -->
	<section class="page-hero onboarding-hero">
		<div class="container">
			<p class="label reveal">
				<span class="bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
				Welcome Aboard
			</p>

			<div class="page-hero__grid">
				<h1 class="page-hero__title reveal-lines">
					<span class="line"><span class="line__inner">Let’s Get You</span></span>
					<span class="line" style="--i: 1"><span class="line__inner muted">Set Up</span></span>
				</h1>

				<div>
					<p class="lead reveal" style="--d: 0.15s">
						A few quick details and we'll start building your AI-powered system. The more we know, the faster you'll
						be up and running.
					</p>

					<ol class="onboarding__steps" role="list">
						{
							steps.map((step, i) => (
								<li class="reveal" style={`--d: ${0.2 + i * 0.06}s; --c: ${brand(i * 2)}`}>
									<span class="onboarding__step-num" aria-hidden="true">
										{pad(i + 1)}
									</span>
									{step}
								</li>
							))
						}
					</ol>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================
	     Form
	     ============================================ -->
	<section class="onboarding">
		<div class="container">
			<div class="onboarding__form reveal">
				<!-- LeadConnector form: attributes are read by form_embed.js, which also auto-sizes the iframe -->
				<iframe
					src={`https://api.leadconnectorhq.com/widget/form/${formId}`}
					class="onboarding__iframe"
					id={`inline-${formId}`}
					title="Onboarding form"
					data-layout="{'id':'INLINE'}"
					data-trigger-type="alwaysShow"
					data-trigger-value=""
					data-activation-type="alwaysActivated"
					data-activation-value=""
					data-deactivation-type="neverDeactivate"
					data-deactivation-value=""
					data-form-name="1 AU - Latest Onboarding Form - GENERAL"
					data-height="4230"
					data-layout-iframe-id={`inline-${formId}`}
					data-form-id={formId}></iframe>
			</div>
		</div>
	</section>

	<script is:inline src="https://link.msgsndr.com/js/form_embed.js" async></script>
</Layout>
