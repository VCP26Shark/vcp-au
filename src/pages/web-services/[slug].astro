---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { services, type Service } from '../../data/services';
import '../../styles/pages/service.css';

export const getStaticPaths = (() =>
	services.map((service, i) => ({
		params: { slug: service.slug },
		props: { service, index: i },
	}))) satisfies GetStaticPaths;

interface Props {
	service: Service;
	index: number;
}

const { service, index } = Astro.props;
const { title, headline, lead, facts, overview, image, included, steps, stack, faqs } = service;
const others = services
	.map((s, i) => ({ ...s, num: i + 1 }))
	.filter((s) => s.slug !== service.slug);

const pad = (n: number) => String(n).padStart(2, '0');
const arrow = '<path d="M5 12h14M12 5l7 7-7 7"/>';
const check = '<path d="M20 6 9 17l-5-5"/>';

// The logo's five colour bars, used as small accents (index 0-4 maps to --brand-1 … --brand-5)
const brand = (i: number) => `var(--brand-${(i % 5) + 1})`;

// The overview reads in word by word as it scrolls
const overviewWords = overview.split(' ');
---

<Layout title={`${title} | VCPility Web Services`} description={lead}>
	<!-- ============================================
	     Hero: breadcrumb, two-tone headline, facts strip
	     ============================================ -->
	<section class="page-hero svc-hero" data-pause-offscreen>
		<canvas class="svc-hero__grid" aria-hidden="true" data-flicker-grid></canvas>

		<div class="container">
			<nav class="svc-crumbs reveal" aria-label="Breadcrumb">
				<a href="/web-services">Web Services</a>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
				<span aria-current="page">{title}</span>
			</nav>

			<p class="label reveal" style="--d: 0.04s">
				<span class="bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
				Service {pad(index + 1)} of {pad(services.length)}
			</p>

			<div class="page-hero__grid">
				<h1 class="page-hero__title reveal-lines" style="--d: 0.08s">
					{
						headline.map((text, i) => (
							<span class="line" style={`--i: ${i}`}>
								<span class:list={['line__inner', i === headline.length - 1 && 'muted']}>{text}</span>
							</span>
						))
					}
				</h1>

				<div>
					<p class="lead reveal" style="--d: 0.2s">{lead}</p>
					<div class="page-hero__buttons reveal" style="--d: 0.28s">
						<a href="/contact" class="btn btn--accent btn--shine" data-magnetic>
							Start a project
							<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
						</a>
						<a href="#included" class="btn btn--link">What's included</a>
					</div>
				</div>
			</div>

			<dl class="svc-facts">
				{
					facts.map(({ label, value }, i) => (
						<div class="reveal" style={`--d: ${0.3 + i * 0.06}s; --c: ${brand(i * 2)}`}>
							<dt>{label}</dt>
							<dd>{value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- ============================================
	     01 Overview: statement (Text Reveal) and a wide photo
	     ============================================ -->
	<section class="chapter svc-overview">
		<div class="container">
			<p class="label reveal"><span class="label__num">01</span>Overview</p>

			<p class="svc-overview__statement" data-scroll-text>
				{
					overviewWords.map((word, i) => (
						<span class="w" style={`--w: ${(i / overviewWords.length).toFixed(3)}`}>
							{word}{' '}
						</span>
					))
				}
			</p>

			<figure class="svc-figure" data-reveal>
				<div class="svc-figure__frame">
					<Image
						src={image.src}
						alt={image.alt}
						widths={[800, 1400, 2000, 2400]}
						sizes="90vw"
						style={image.position ? `object-position: ${image.position}` : undefined}
					/>
				</div>
				<figcaption><span>{image.label}</span> {image.caption}</figcaption>
			</figure>
		</div>
	</section>

	<!-- ============================================
	     02 What's included: surface cards (Magic Card spotlight)
	     ============================================ -->
	<section class="chapter svc-included" id="included">
		<div class="container">
			<p class="label reveal"><span class="label__num">02</span>What's included</p>

			<div class="chapter__head">
				<h2 class="display reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">Everything it takes,</span></span>
					<span class="line" style="--i: 1"><span class="line__inner muted">done properly.</span></span>
				</h2>
				<p class="lead reveal" style="--d: 0.2s">
					One team handles every part, so nothing falls between suppliers and you always know who to call.
				</p>
			</div>

			<ul class="svc-grid">
				{
					included.map(({ title: item, desc }, i) => (
						<li class="svc-grid__item reveal" style={`--d: ${(i % 3) * 0.06}s`}>
							<div class="card" data-spotlight>
								<div class="svc-grid__head">
									<span class="svc-grid__num">{pad(i + 1)}</span>
									<svg viewBox="0 0 24 24" aria-hidden="true" set:html={check} data-draw />
								</div>
								<h3>{item}</h3>
								<p>{desc}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ============================================
	     03 How we deliver: the ink chapter, four steps on a rail
	     with a travelling beam (Animated Beam), on a Flickering Grid
	     ============================================ -->
	<section class="chapter chapter--ink svc-process" data-pause-offscreen>
		<canvas class="svc-process__grid" aria-hidden="true" data-flicker-grid data-flicker-color="255, 255, 255"></canvas>

		<div class="container">
			<p class="label reveal"><span class="label__num">03</span>How we deliver</p>

			<div class="chapter__head">
				<h2 class="display reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">Four clear steps.</span></span>
				</h2>
				<p class="lead reveal" style="--d: 0.2s">
					You'll know what's happening, what's next and what it costs at every stage.
				</p>
			</div>

			<ol class="svc-steps" data-reveal>
				<li class="svc-steps__rail" aria-hidden="true"><span></span></li>
				{
					steps.map(({ title: step, desc }, i) => (
						<li class="svc-step" style={`--i: ${i}`}>
							<span class="svc-step__node" aria-hidden="true">
								{pad(i + 1)}
							</span>
							<h3>{step}</h3>
							<p>{desc}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ============================================
	     Technologies: a single ruled band of chips
	     ============================================ -->
	<section class="svc-stack">
		<div class="container svc-stack__inner">
			<p class="svc-stack__label reveal">Technologies we use</p>
			<ul class="svc-stack__list">
				{
					stack.map((item, i) => (
						<li class="reveal" style={`--d: ${i * 0.04}s; --c: ${brand(i)}`}>
							{item}
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ============================================
	     04 FAQ: sticky heading beside the accordion
	     ============================================ -->
	<section class="chapter svc-faq">
		<div class="container svc-faq__grid">
			<div class="svc-faq__head">
				<p class="label reveal"><span class="label__num">04</span>FAQ</p>
				<h2 class="display reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">Questions,</span></span>
					<span class="line" style="--i: 1"><span class="line__inner muted">answered.</span></span>
				</h2>
			</div>
			<div class="svc-faq__list reveal" style="--d: 0.15s">
				{
					faqs.map(({ q, a }, i) => (
						<details open={i === 0}>
							<summary>
								{q}
								<span class="svc-faq__icon" aria-hidden="true" />
							</summary>
							<p>{a}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<!-- ============================================
	     Closing CTA: shader panel with Ripple rings (Magic UI)
	     ============================================ -->
	<section class="finale">
		<div class="container">
			<div class="finale__panel" data-pause-offscreen>
				<canvas class="shader" aria-hidden="true" data-shader></canvas>
				<span class="ripple" aria-hidden="true">
					{[0, 1, 2, 3, 4].map((n) => <span style={`--n: ${n}`} />)}
				</span>

				<div class="finale__inner">
					<span class="bars bars--light reveal" aria-hidden="true"
						><span></span><span></span><span></span><span></span><span></span></span
					>
					<h2 class="finale__title reveal-lines" style="--d: 0.1s">
						<span class="line"><span class="line__inner">Let's talk about</span></span>
						<span class="line" style="--i: 1"><span class="line__inner">your project.</span></span>
					</h2>
					<p class="finale__text reveal" style="--d: 0.25s">
						Tell us what you're planning. We'll come back with clear next steps and an honest estimate.
					</p>
					<div class="finale__buttons reveal" style="--d: 0.3s">
						<a href="/contact" class="btn btn--light btn--shine" data-magnetic>
							Start a project
							<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
						</a>
						<a href="mailto:growth@vcpility.com.au" class="btn btn--link btn--on-ink">growth@vcpility.com.au</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================
	     05 More services: an index of the other pages
	     ============================================ -->
	<section class="chapter svc-more">
		<div class="container">
			<p class="label reveal"><span class="label__num">05</span>More services</p>

			<div class="chapter__head">
				<h2 class="display reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">Explore what</span></span>
					<span class="line" style="--i: 1"><span class="line__inner muted">else we do.</span></span>
				</h2>
				<p class="lead reveal" style="--d: 0.2s">
					<a href="/web-services" class="btn btn--link">
						All web services
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
					</a>
				</p>
			</div>

			<ul class="svc-more__list">
				{
					others.map(({ slug, title: name, summary, num }, i) => (
						<li class="reveal" style={`--d: ${i * 0.05}s`}>
							<a href={`/web-services/${slug}`} class="svc-more__item" aria-label={`${name}: ${summary}`}>
								<span class="svc-more__num">{pad(num)}</span>
								<span class="svc-more__title" data-scramble>
									{name}
								</span>
								<span class="svc-more__desc">{summary}</span>
								<svg class="svc-more__arrow" viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>
