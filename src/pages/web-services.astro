---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import teamPhoto from '../assets/web-services/team.jpg';
import wireframePhoto from '../assets/web-services/wireframe.jpg';
import codePhoto from '../assets/web-services/code.jpg';
import { services } from '../data/services';
import '../styles/pages/web-services.css';

/* Photos are CC0 (public domain) from StockSnap.io: no licence fee or credit required. */

/* ----- Why VCPility ----- */

const principles = [
	{
		title: 'The Depth of a Product Company',
		desc: 'We build and run software for a living. Your project gets the same engineering standards, infrastructure and security as the Sharktech platforms.',
	},
	{
		title: 'Senior People, Start to Finish',
		desc: 'The team that scopes your project is the team that designs and builds it. One point of contact, no hand-offs and no surprises.',
	},
	{
		title: 'Measured on Results',
		desc: 'Before we start, we agree the numbers that matter, like enquiries, bookings, speed and rankings. After launch, we report against them.',
	},
];

/* ----- Technologies, grouped by what they're for ----- */

const stack = [
	{
		category: 'Websites',
		items: ['Astro', 'WordPress', 'Webflow', 'Tailwind CSS'],
	},
	{
		category: 'Web Apps',
		items: ['React', 'Next.js', 'Vue', 'Node.js', 'Laravel'],
	},
	{
		category: 'CMS',
		items: ['Headless WordPress', 'Sanity', 'Strapi', 'Contentful'],
	},
	{
		category: 'E-commerce',
		items: ['Shopify', 'WooCommerce', 'Stripe', 'PayPal'],
	},
	{
		category: 'Data & Hosting',
		items: ['PostgreSQL', 'MySQL', 'Vercel', 'Cloudflare', 'AWS'],
	},
];

/* ----- Results -----
   Numeric entries count up from zero; `text` entries render as they are. */

const results = [
	{ count: 50, suffix: '+', label: 'Businesses grown on Sharktech-built platforms' },
	{ count: 90, suffix: '+', label: 'Lighthouse performance score we build every site to' },
	{ count: 2.5, decimals: 1, prefix: '<', suffix: 's', label: 'Largest Contentful Paint target at launch' },
	{ text: 'AA', label: 'WCAG 2.2 accessibility on every build, as standard' },
];

/* ----- Process ----- */

const steps = [
	{
		title: 'Discover',
		desc: "We learn your business, customers and goals, then agree a scope, a timeline and the numbers we'll measure.",
	},
	{
		title: 'Design',
		desc: 'Wireframes and visual designs you can click through, refined with you before production code is written.',
	},
	{
		title: 'Build',
		desc: 'Engineered for speed, accessibility and search, tested across devices and connected to the tools you use.',
	},
	{
		title: 'Launch & Grow',
		desc: 'A careful launch, then ongoing care: monitoring, updates and improvements guided by real data.',
	},
];

const pad = (n: number) => String(n).padStart(2, '0');
const arrow = '<path d="M5 12h14M12 5l7 7-7 7"/>';
---

<Layout
	title="Web Services & Development | VCPility"
	description="VCPility is the web services and development arm of Sharktech Global. Websites, web apps, e-commerce and integrations, designed, engineered and supported by an experienced Australian team."
	keywords="web development Australia, website design Sydney, web applications, e-commerce development, Sharktech Global, VCPility"
>
	<!-- ============================================
	     Hero
	     ============================================ -->
	<section class="ws-hero">
		<canvas class="ws-hero__grid" aria-hidden="true" data-flicker-grid></canvas>

		<div class="ws-hero__content">
			<p class="eyebrow ws-hero__eyebrow reveal">Sharktech Global · Web Services</p>

			<h1 class="ws-hero__title reveal-lines" style="--d: 0.1s">
				<span class="line" style="--i: 0"><span class="line__inner">Websites engineered</span></span>
				<span class="line" style="--i: 1"
					><span class="line__inner">to grow your business.</span></span
				>
			</h1>

			<p class="ws-hero__lead reveal" style="--d: 0.35s">
				VCPility is the web services and development side of Sharktech Global. We plan, design, build and look after
				websites and web applications that bring in real, measurable results.
			</p>

			<div class="ws-hero__actions reveal" style="--d: 0.45s">
				<a href="/contact" class="btn btn--accent btn--shine">
					Start a project
					<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
				</a>
				<a href="#services" class="btn btn--link">What we build</a>
			</div>
		</div>

		<ul class="ws-hero__facts reveal" style="--d: 0.6s">
			<li><span>Part of</span> Sharktech Global</li>
			<li><span>Based in</span> Sydney &amp; Melbourne</li>
			<li><span>From</span> Strategy to support</li>
		</ul>
	</section>

	<!-- ============================================
	     Statement + why VCPility
	     ============================================ -->
	<section class="ws-intro">
		<div class="ws-wrap">
			<p class="eyebrow reveal">Who we are</p>
			<p class="ws-intro__statement reveal" style="--d: 0.1s">
				A product company's engineering depth, with <em>the care of a studio.</em> Every site we launch is built
				to the standards we use for our own platforms.
			</p>

			<figure class="ws-figure ws-figure--wide" data-reveal>
				<div class="ws-figure__frame">
					<Image
						src={teamPhoto}
						alt="A small team working through a project together around a table with laptops and notebooks"
						widths={[800, 1400, 2000, 2400]}
						sizes="90vw"
					/>
				</div>
				<figcaption><span>Studio</span> Strategy, design and engineering around one table</figcaption>
			</figure>

			<ol class="ws-principles">
				{
					principles.map(({ title, desc }, i) => (
						<li class="ws-principle reveal" style={`--d: ${i * 0.1}s`}>
							<span class="ws-principle__num">{pad(i + 1)}</span>
							<h3>{title}</h3>
							<p>{desc}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ============================================
	     Services
	     ============================================ -->
	<section class="ws-services" id="services">
		<div class="ws-wrap">
			<header class="ws-head">
				<div>
					<p class="eyebrow reveal">What we do</p>
					<h2 class="section-title section-title--sm reveal-lines">
						<span class="line"><span class="line__inner">Everything your</span></span>
						<span class="line" style="--i: 1"
							><span class="line__inner">business needs online.</span></span
						>
					</h2>
				</div>
				<p class="ws-head__lead reveal" style="--d: 0.15s">
					One team for the whole job, from the first sketch to the thousandth visitor. Take a single service or
					hand us the lot.
				</p>
			</header>

			<ul class="ws-service-list">
				{
					services.map(({ slug, title, summary, tags }, i) => (
						<li class="ws-service reveal" style={`--d: ${(i % 2) * 0.08}s`}>
							<span class="ws-service__num">{pad(i + 1)}</span>
							<h3 class="ws-service__title">
								<a href={`/web-services/${slug}`}>{title}</a>
							</h3>
							<div class="ws-service__body">
								<p>{summary}</p>
								<ul class="ws-tags">
									{tags.map((tag) => (
										<li>{tag}</li>
									))}
								</ul>
							</div>
							<svg class="ws-service__arrow" viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
						</li>
					))
				}
			</ul>

			<div class="ws-pair">
				<figure class="ws-figure" data-reveal>
					<div class="ws-figure__frame">
						<Image
							src={wireframePhoto}
							alt="Hand-drawn website wireframes on paper with a pen resting on top"
							widths={[640, 1000, 1400]}
							sizes="(max-width: 768px) 90vw, 45vw"
						/>
					</div>
					<figcaption><span>Design</span> Every layout starts as a sketch</figcaption>
				</figure>
				<figure class="ws-figure" data-reveal style="--d: 0.15s">
					<div class="ws-figure__frame">
						<Image
							src={codePhoto}
							alt="Close-up of colourful source code on a dark editor screen"
							widths={[640, 1000, 1400]}
							sizes="(max-width: 768px) 90vw, 45vw"
						/>
					</div>
					<figcaption><span>Build</span> Hand-written code, engineered to last</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<!-- ============================================
	     Technologies
	     ============================================ -->
	<section class="ws-stack">
		<div class="ws-wrap">
			<header class="ws-head">
				<div>
					<p class="eyebrow reveal">Technologies</p>
					<h2 class="section-title section-title--sm reveal-lines">
						<span class="line"><span class="line__inner">The right tools</span></span>
						<span class="line" style="--i: 1"><span class="line__inner">for every build.</span></span>
					</h2>
				</div>
				<p class="ws-head__lead reveal" style="--d: 0.15s">
					We pick the stack to suit the project, not the other way round. These are the platforms we build on most.
				</p>
			</header>

			<div class="ws-stack__grid">
				{
					stack.map(({ category, items }, i) => (
						<div class="ws-stack__col reveal" style={`--d: ${i * 0.08}s`}>
							<h3>{category}</h3>
							<ul>
								{items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- ============================================
	     Results
	     ============================================ -->
	<section class="ws-results">
		<div class="ws-wrap">
			<header class="ws-head">
				<div>
					<p class="eyebrow reveal">Results</p>
					<h2 class="section-title section-title--sm reveal-lines">
						<span class="line"><span class="line__inner">Quality you can</span></span>
						<span class="line" style="--i: 1"><span class="line__inner">measure.</span></span>
					</h2>
				</div>
				<p class="ws-head__lead reveal" style="--d: 0.15s">
					Good-looking is the starting point. We hold every build to clear standards for speed, accessibility and
					search, because that's what turns visitors into enquiries.
				</p>
			</header>

			<dl class="ws-stats">
				{
					results.map(({ count, decimals, prefix = '', suffix = '', text, label }, i) => (
						<div class="ws-stat reveal" style={`--d: ${i * 0.08}s`}>
							<dt class="ws-stat__label">{label}</dt>
							{count !== undefined ? (
								<dd
									class="ws-stat__value"
									data-count={count}
									data-decimals={decimals}
									data-prefix={prefix}
									data-suffix={suffix}
									data-count-delay={i * 120}
								>
									{prefix}
									{count}
									{suffix}
								</dd>
							) : (
								<dd class="ws-stat__value">{text}</dd>
							)}
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- ============================================
	     Process
	     ============================================ -->
	<section class="ws-process">
		<div class="ws-wrap">
			<header class="ws-head">
				<div>
					<p class="eyebrow reveal">How we work</p>
					<h2 class="section-title section-title--sm reveal-lines">
						<span class="line"><span class="line__inner">A clear process,</span></span>
						<span class="line" style="--i: 1"
							><span class="line__inner">start to launch.</span></span
						>
					</h2>
				</div>
				<p class="ws-head__lead reveal" style="--d: 0.15s">
					You'll always know what's happening, what's next and what it costs. No jargon, no black boxes.
				</p>
			</header>

			<ol class="ws-steps" data-reveal>
				{
					steps.map(({ title, desc }, i) => (
						<li class="ws-step" style={`--i: ${i}`}>
							<span class="ws-step__num">{pad(i + 1)}</span>
							<h3>{title}</h3>
							<p>{desc}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ============================================
	     CTA (Border Beam)
	     ============================================ -->
	<section class="ws-cta-section">
		<div class="ws-wrap">
			<div class="ws-cta reveal" data-pause-offscreen>
				<span class="ws-cta__beam" aria-hidden="true"></span>
				<span class="ws-cta__beam ws-cta__beam--trail" aria-hidden="true"></span>

				<p class="eyebrow eyebrow--center">Let's build it</p>
				<h2 class="section-title section-title--compact">Have a project in mind?</h2>
				<p class="ws-cta__lead">
					Tell us what you're planning. We'll come back with clear next steps and an honest estimate.
				</p>
				<div class="ws-cta__actions">
					<a href="/contact" class="btn btn--accent btn--shine">
						Start a project
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
					</a>
					<a href="mailto:growth@vcpility.com.au" class="btn btn--link">growth@vcpility.com.au</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	import { initFlickerGrids } from '../scripts/flicker-grid';

	initFlickerGrids();
</script>
