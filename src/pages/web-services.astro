---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import teamPhoto from '../assets/web-services/team.jpg';
import wireframePhoto from '../assets/web-services/wireframe.jpg';
import codePhoto from '../assets/web-services/code.jpg';
import { services } from '../data/services';
import '../styles/pages/web-services.css';

/* Photos are CC0 (public domain) from StockSnap.io: no licence fee or credit required. */

const pad = (n: number) => String(n).padStart(2, '0');
const arrow = '<path d="M5 12h14M12 5l7 7-7 7"/>';

// The logo's five colour bars, used as small accents (index 0-4 maps to --brand-1 … --brand-5)
const brand = (i: number) => `var(--brand-${(i % 5) + 1})`;

/* ----- Hero ----- */

const heroFacts = [
	{ label: 'Part of', value: 'Sharktech Global' },
	{ label: 'Based in', value: 'Sydney & Melbourne' },
	{ label: 'From', value: 'Strategy to support' },
];

/* ----- Who we are: the statement reads in word by word as it scrolls; the
   emphasised phrase sits in a lighter tone ----- */

const statement = [
	{ text: "A product company's engineering depth, with" },
	{ text: 'the care of a studio.', em: true },
	{ text: 'Every site we launch is built to the standards we use for our own platforms.' },
];
const statementWords = statement.flatMap(({ text, em = false }) => text.split(' ').map((word) => ({ word, em })));

const principles = [
	{
		title: 'The Depth of a Product Company',
		desc: 'We build and run software for a living. Your project gets the same engineering standards, infrastructure and security as the Sharktech platforms.',
		icon: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
	},
	{
		title: 'Senior People, Start to Finish',
		desc: 'The team that scopes your project is the team that designs and builds it. One point of contact, no hand-offs and no surprises.',
		icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
	},
	{
		title: 'Measured on Results',
		desc: 'Before we start, we agree the numbers that matter, like enquiries, bookings, speed and rankings. After launch, we report against them.',
		icon: '<path d="M3 3v18h18"/><path d="M18 17V9M13 17V5M8 17v-3"/>',
	},
];

/* ----- Technologies, grouped by what they're for ----- */

const stack = [
	{
		category: 'Websites',
		items: ['Astro', 'WordPress', 'Webflow', 'Tailwind CSS'],
	},
	{
		category: 'Web Apps',
		items: ['React', 'Next.js', 'Vue', 'Node.js', 'Laravel'],
	},
	{
		category: 'CMS',
		items: ['Headless WordPress', 'Sanity', 'Strapi', 'Contentful'],
	},
	{
		category: 'E-commerce',
		items: ['Shopify', 'WooCommerce', 'Stripe', 'PayPal'],
	},
	{
		category: 'Data & Hosting',
		items: ['PostgreSQL', 'MySQL', 'Vercel', 'Cloudflare', 'AWS'],
	},
];

// Every tool in one line, for the drifting row above the columns
const stackItems = stack.flatMap(({ items }) => items);

/* ----- Results: numbers roll in on reveal; `text` entries render as they are ----- */

const results = [
	{ value: '50+', label: 'Businesses grown on Sharktech-built platforms' },
	{ value: '90+', label: 'Lighthouse performance score we build every site to' },
	{ value: '<2.5s', label: 'Largest Contentful Paint target at launch' },
	{ text: 'AA', label: 'WCAG 2.2 accessibility on every build, as standard' },
];

/* ----- Process ----- */

const steps = [
	{
		title: 'Discover',
		desc: "We learn your business, customers and goals, then agree a scope, a timeline and the numbers we'll measure.",
	},
	{
		title: 'Design',
		desc: 'Wireframes and visual designs you can click through, refined with you before production code is written.',
	},
	{
		title: 'Build',
		desc: 'Engineered for speed, accessibility and search, tested across devices and connected to the tools you use.',
	},
	{
		title: 'Launch & Grow',
		desc: 'A careful launch, then ongoing care: monitoring, updates and improvements guided by real data.',
	},
];
---

<Layout
	title="Web Services & Development | VCPility"
	description="VCPility is the web services and development arm of Sharktech Global. Websites, web apps, e-commerce and integrations, designed, engineered and supported by an experienced Australian team."
	keywords="web development Australia, website design Sydney, web applications, e-commerce development, Sharktech Global, VCPility"
>
	<!-- ============================================
	     Hero: flickering grid behind the two-tone title
	     ============================================ -->
	<section class="page-hero ws-hero" data-pause-offscreen>
		<canvas class="ws-hero__grid" aria-hidden="true" data-flicker-grid></canvas>

		<div class="container">
			<p class="label reveal">
				<span class="bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
				Sharktech Global · Web Services
			</p>

			<div class="page-hero__grid">
				<h1 class="page-hero__title reveal-lines" style="--d: 0.05s">
					<span class="line"><span class="line__inner">Websites engineered</span></span>
					<span class="line" style="--i: 1"><span class="line__inner muted">to grow your business.</span></span>
				</h1>

				<div>
					<p class="lead reveal" style="--d: 0.2s">
						VCPility is the web services and development side of Sharktech Global. We plan, design, build and look
						after websites and web applications that bring in real, measurable results.
					</p>
					<div class="page-hero__buttons reveal" style="--d: 0.28s">
						<a href="/contact" class="btn btn--accent btn--shine" data-magnetic>
							Start a project
							<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
						</a>
						<a href="#services" class="btn btn--link">What we build</a>
					</div>
				</div>
			</div>

			<ul class="ws-facts">
				{
					heroFacts.map(({ label, value }, i) => (
						<li class="reveal" style={`--d: ${0.3 + i * 0.06}s; --c: ${brand(i * 2)}`}>
							<span>{label}</span> {value}
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ============================================
	     01 Who we are: statement (Text Reveal), photo and principles
	     ============================================ -->
	<section class="chapter ws-intro">
		<div class="container">
			<p class="label reveal"><span class="label__num">01</span>Who we are</p>

			<p class="ws-intro__statement" data-scroll-text>
				{
					statementWords.map(({ word, em }, i) => (
						<span class:list={['w', em && 'muted']} style={`--w: ${(i / statementWords.length).toFixed(3)}`}>
							{word}{' '}
						</span>
					))
				}
			</p>

			<figure class="ws-figure ws-figure--wide" data-reveal>
				<div class="ws-figure__frame">
					<Image
						src={teamPhoto}
						alt="A small team working through a project together around a table with laptops and notebooks"
						widths={[800, 1400, 2000, 2400]}
						sizes="90vw"
					/>
				</div>
				<figcaption><span>Studio</span> Strategy, design and engineering around one table</figcaption>
			</figure>

			<ol class="ws-principles">
				{
					principles.map(({ title, desc, icon }, i) => (
						<li class="ws-principle reveal" style={`--d: ${i * 0.08}s`}>
							<div class="ws-principle__head">
								<span class="ws-principle__num">{pad(i + 1)}</span>
								<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} data-draw />
							</div>
							<h3>{title}</h3>
							<p>{desc}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ============================================
	     02 Services: an index of rows, each linking to its own page
	     ============================================ -->
	<section class="chapter ws-services" id="services">
		<div class="container">
			<p class="label reveal"><span class="label__num">02</span>What we do</p>

			<div class="chapter__head">
				<h2 class="display reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">Everything your</span></span>
					<span class="line" style="--i: 1"><span class="line__inner muted">business needs online.</span></span>
				</h2>
				<p class="lead reveal" style="--d: 0.2s">
					One team for the whole job, from the first sketch to the thousandth visitor. Take a single service or hand
					us the lot.
				</p>
			</div>

			<ul class="ws-index">
				{
					services.map(({ slug, title, summary, tags }, i) => (
						<li class="ws-index__row reveal" style={`--d: ${(i % 3) * 0.05}s`}>
							<span class="ws-index__num">{pad(i + 1)}</span>
							<h3 class="ws-index__title">
								<a href={`/web-services/${slug}`}>{title}</a>
							</h3>
							<div class="ws-index__body">
								<p>{summary}</p>
								<ul class="ws-tags">
									{tags.map((tag) => (
										<li>{tag}</li>
									))}
								</ul>
							</div>
							<svg class="ws-index__arrow" viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
						</li>
					))
				}
			</ul>

			<div class="ws-pair">
				<figure class="ws-figure" data-reveal>
					<div class="ws-figure__frame">
						<Image
							src={wireframePhoto}
							alt="Hand-drawn website wireframes on paper with a pen resting on top"
							widths={[640, 1000, 1400]}
							sizes="(max-width: 768px) 90vw, 45vw"
						/>
					</div>
					<figcaption><span>Design</span> Every layout starts as a sketch</figcaption>
				</figure>
				<figure class="ws-figure" data-reveal style="--d: 0.1s">
					<div class="ws-figure__frame">
						<Image
							src={codePhoto}
							alt="Close-up of colourful source code on a dark editor screen"
							widths={[640, 1000, 1400]}
							sizes="(max-width: 768px) 90vw, 45vw"
						/>
					</div>
					<figcaption><span>Build</span> Hand-written code, engineered to last</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<!-- ============================================
	     03 Technologies: a drifting row of every tool (Scroll Based Velocity),
	     then the tools grouped in cards
	     ============================================ -->
	<section class="chapter ws-stack">
		<div class="container">
			<p class="label reveal"><span class="label__num">03</span>Technologies</p>

			<div class="chapter__head">
				<h2 class="display reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">The right tools</span></span>
					<span class="line" style="--i: 1"><span class="line__inner muted">for every build.</span></span>
				</h2>
				<p class="lead reveal" style="--d: 0.2s">
					We pick the stack to suit the project, not the other way round. These are the platforms we build on most.
				</p>
			</div>
		</div>

		<div class="ws-velocity" aria-hidden="true" data-velocity="1">
			<div class="ws-velocity__track">
				{
					[0, 1].map(() =>
						stackItems.map((item, i) => (
							<span class="ws-velocity__item">
								{item}
								<span class="ws-velocity__dot" style={`background: ${brand(i)}`} />
							</span>
						)),
					)
				}
			</div>
		</div>

		<div class="container">
			<div class="ws-stack__grid">
				{
					stack.map(({ category, items }, i) => (
						<div class="ws-stack__card reveal" style={`--d: ${i * 0.06}s; --c: ${brand(i)}`}>
							<h3>{category}</h3>
							<ul>
								{items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- ============================================
	     04 Results: rolling figures (Number Ticker) on a Flickering Grid
	     ============================================ -->
	<section class="chapter chapter--ink ws-results" data-pause-offscreen>
		<canvas class="ws-results__grid" aria-hidden="true" data-flicker-grid data-flicker-color="255, 255, 255"></canvas>

		<div class="container">
			<p class="label reveal"><span class="label__num">04</span>Results</p>

			<div class="chapter__head">
				<h2 class="display reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">Quality you can</span></span>
					<span class="line" style="--i: 1"><span class="line__inner muted">measure.</span></span>
				</h2>
				<p class="lead reveal" style="--d: 0.2s">
					Good-looking is the starting point. We hold every build to clear standards for speed, accessibility and
					search, because that's what turns visitors into enquiries.
				</p>
			</div>

			<dl class="ws-stats">
				{
					results.map(({ value, text, label }, i) => (
						<div class="ws-stat reveal" style={`--d: ${i * 0.08}s; --c: ${brand(i)}`}>
							<dt>{label}</dt>
							{value ? (
								<dd class="ticker" data-ticker data-reveal style={`--d: ${i * 0.12}s`}>
									{value}
								</dd>
							) : (
								<dd>{text}</dd>
							)}
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- ============================================
	     05 Process: sticky heading beside a Tracing Beam (Aceternity UI)
	     ============================================ -->
	<section class="chapter ws-process">
		<div class="container ws-process__layout">
			<header class="ws-process__head">
				<p class="label reveal"><span class="label__num">05</span>How we work</p>
				<h2 class="display reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">A clear process,</span></span>
					<span class="line" style="--i: 1"><span class="line__inner muted">start to launch.</span></span>
				</h2>
				<p class="lead reveal" style="--d: 0.2s">
					You'll always know what's happening, what's next and what it costs. No jargon, no black boxes.
				</p>
			</header>

			<ol class="ws-steps" data-trace>
				<li class="ws-steps__beam" aria-hidden="true"><span></span></li>
				{
					steps.map(({ title, desc }, i) => (
						<li class="ws-step" data-trace-step>
							<span class="ws-step__num" aria-hidden="true">
								{pad(i + 1)}
							</span>
							<div class="ws-step__body">
								<h3>{title}</h3>
								<p>{desc}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ============================================
	     Closing CTA: shader panel with Ripple rings (Magic UI)
	     ============================================ -->
	<section class="finale">
		<div class="container">
			<div class="finale__panel" data-pause-offscreen>
				<canvas class="shader" aria-hidden="true" data-shader></canvas>
				<span class="ripple" aria-hidden="true">
					{[0, 1, 2, 3, 4].map((n) => <span style={`--n: ${n}`} />)}
				</span>

				<div class="finale__inner">
					<p class="ws-finale__kicker reveal">
						<span class="bars bars--light" aria-hidden="true"
							><span></span><span></span><span></span><span></span><span></span></span
						>
						Let's build it
					</p>
					<h2 class="finale__title reveal-lines" style="--d: 0.1s">
						<span class="line"><span class="line__inner">Have a project</span></span>
						<span class="line" style="--i: 1"><span class="line__inner">in mind?</span></span>
					</h2>
					<p class="finale__text reveal" style="--d: 0.25s">
						Tell us what you're planning. We'll come back with clear next steps and an honest estimate.
					</p>
					<div class="finale__buttons reveal" style="--d: 0.3s">
						<a href="/contact" class="btn btn--light btn--shine" data-magnetic>
							Start a project
							<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
						</a>
						<a href="mailto:growth@vcpility.com.au" class="btn btn--link btn--on-ink">growth@vcpility.com.au</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
