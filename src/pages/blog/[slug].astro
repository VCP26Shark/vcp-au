---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getPosts, readingTime, formatDate, type Post } from '../../data/blog';
import '../../styles/components/blog.css';
import '../../styles/pages/post.css';

export const getStaticPaths = (async () => {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, others: posts.filter((p) => p.id !== post.id) },
	}));
}) satisfies GetStaticPaths;

interface Props {
	post: Post;
	others: Post[];
}

const { post, others } = Astro.props;
const { title, description, category, date, author, cover, coverAlt } = post.data;
const { Content, headings } = await render(post);
const sections = headings.filter((h) => h.depth === 2);
// Posts whose headings carry their own numbers ("1. ...") skip the contents counters
const numbered = sections.some(({ text }) => /^\d+\.\s/.test(text));

const arrow = '<path d="M5 12h14M12 5l7 7-7 7"/>';

// The facts under the title, each with one of the logo colours as a small dot
const facts = [
	{ label: 'Written by', value: author },
	{ label: 'Published', value: formatDate(date), datetime: date.toISOString() },
	{ label: 'Reading time', value: readingTime(post) },
];
---

<Layout title={`${title} | VCPility Blog`} description={description} ogType="article">
	<!-- ============================================
	     Hero
	     ============================================ -->
	<section class="page-hero post-hero">
		<canvas class="post-hero__grid" aria-hidden="true" data-flicker-grid data-flicker-color="13, 31, 56"></canvas>

		<div class="container">
			<nav class="label post-crumbs reveal" aria-label="Breadcrumb">
				<span class="bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
				<a href="/blog">Blog</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{category}</span>
			</nav>

			<div class="page-hero__grid">
				<h1 class="post-hero__title reveal-lines" style="--d: 0.1s">
					<span class="line"><span class="line__inner">{title}</span></span>
				</h1>
				<p class="lead reveal" style="--d: 0.25s">{description}</p>
			</div>

			<dl class="post-facts reveal" style="--d: 0.35s">
				{
					facts.map(({ label, value, datetime }, i) => (
						<div style={`--c: var(--brand-${i + 1})`}>
							<dt>{label}</dt>
							<dd>{datetime ? <time datetime={datetime}>{value}</time> : value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- ============================================
	     Cover
	     ============================================ -->
	<figure class="container post-cover" data-reveal>
		<div class="post-cover__frame">
			<Image src={cover} alt={coverAlt} widths={[800, 1400, 2000, 2400]} sizes="90vw" loading="eager" />
		</div>
	</figure>

	<!-- ============================================
	     Article: sticky contents beside the text column
	     ============================================ -->
	<div class="container post-layout">
		{
			sections.length > 0 && (
				<aside class="post-toc">
					<nav aria-label="In this article" data-toc>
						<p class="post-toc__label">In this article</p>
						<ol class:list={[numbered && 'post-toc--plain']}>
							{sections.map(({ slug, text }) => (
								<li>
									<a href={`#${slug}`} data-toc-link={slug}>
										{text}
									</a>
								</li>
							))}
						</ol>
					</nav>
				</aside>
			)
		}

		<article class="prose">
			<Content />
		</article>
	</div>

	<!-- ============================================
	     Keep reading
	     ============================================ -->
	{
		others.length > 0 && (
			<section class="chapter post-more">
				<div class="container">
					<p class="label reveal">
						<span class="label__num">01</span>Keep reading
					</p>

					<div class="chapter__head">
						<h2 class="display reveal-lines" style="--d: 0.1s">
							<span class="line"><span class="line__inner">More from</span></span>
							<span class="line" style="--i: 1"><span class="line__inner muted">the journal.</span></span>
						</h2>
						<p class="lead reveal" style="--d: 0.2s">
							<a href="/blog" class="btn btn--link">
								All articles
								<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
							</a>
						</p>
					</div>

					<ul class="post-cards">
						{others.slice(0, 3).map((other, i) => (
							<li class="reveal" style={`--d: ${i * 0.06}s`}>
								<a href={`/blog/${other.id}`} class="card post-card" data-spotlight>
									<span class="post-card__media">
										<Image src={other.data.cover} alt="" widths={[480, 800, 1200]} sizes="(max-width: 768px) 90vw, 30vw" />
									</span>
									<span class="post-card__body">
										<span class="post-meta">
											<span>{other.data.category}</span>
											<span>{readingTime(other)}</span>
										</span>
										<span class="post-card__title">{other.data.title}</span>
										<span class="post-card__desc">{other.data.description}</span>
										<time class="post-card__date" datetime={other.data.date.toISOString()}>
											{formatDate(other.data.date)}
										</time>
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<!-- ============================================
	     Closing CTA: shader panel with Ripple rings
	     ============================================ -->
	<section class="finale">
		<div class="container">
			<div class="finale__panel" data-pause-offscreen>
				<canvas class="shader" aria-hidden="true" data-shader></canvas>
				<span class="ripple" aria-hidden="true">
					{[0, 1, 2, 3, 4].map((n) => <span style={`--n: ${n}`} />)}
				</span>

				<div class="finale__inner">
					<span class="bars bars--light reveal" aria-hidden="true"
						><span></span><span></span><span></span><span></span><span></span></span
					>
					<h2 class="finale__title reveal-lines" style="--d: 0.1s">
						<span class="line"><span class="line__inner">Put the ideas</span></span>
						<span class="line" style="--i: 1"><span class="line__inner">to work.</span></span>
					</h2>
					<p class="finale__text reveal" style="--d: 0.3s">
						See how VCPility automates your enquiries, reviews and follow-ups, so your team can get on with the
						work.
					</p>
					<div class="finale__buttons reveal" style="--d: 0.4s">
						<a href="/contact" class="btn btn--light btn--shine" data-magnetic>
							Book a demo
							<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
						</a>
						<a href="/features" class="btn btn--link btn--on-ink">
							Explore the features
							<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	/* Highlight the contents link for the section being read, and keep it in view
	   when the list is taller than the screen */
	const toc = document.querySelector<HTMLElement>('[data-toc]');
	const links = new Map(
		[...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((a) => [a.dataset.tocLink, a]),
	);

	if (toc && links.size) {
		const spy = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const active = links.get(entry.target.id);
					if (!active) continue;
					links.forEach((a) => a.removeAttribute('aria-current'));
					active.setAttribute('aria-current', 'true');

					if (toc.scrollHeight > toc.clientHeight) {
						toc.scrollTo({ top: active.offsetTop - toc.clientHeight / 3, behavior: 'smooth' });
					}
				}
			},
			{ rootMargin: '-15% 0px -70% 0px' },
		);

		document.querySelectorAll('.prose h2[id]').forEach((h) => spy.observe(h));
	}
</script>
